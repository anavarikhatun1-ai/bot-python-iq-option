b_cross_low8 = not b_Rising_Upper_Falling_Lower and b_low_sl8 * time < 0 ? 0 : b_line_cross(close, b_low_x8, b_low_y8, b_low_sl8, log_chart)
b_cross_high9 = not b_Rising_Upper_Falling_Lower and b_high_sl9 * time > 0 ? 0 : b_line_cross(close, b_high_x9, b_high_y9, b_high_sl9, log_chart)
b_cross_low9 = not b_Rising_Upper_Falling_Lower and b_low_sl9 * time < 0 ? 0 : b_line_cross(close, b_low_x9, b_low_y9, b_low_sl9, log_chart)

b_long_break = (b_trendline_nr > 9 ? b_cross_high9 == 1 or (b_select_breaks ? false : b_cross_low9 == 1) : false) or (b_trendline_nr > 8 ? b_cross_high8 == 1 or (b_select_breaks ? false : b_cross_low8 == 1) : false) or (b_trendline_nr > 7 ? b_cross_high7 == 1 or (b_select_breaks ? false : b_cross_low7 == 1) : false) or (b_trendline_nr > 6 ? b_cross_high6 == 1 or (b_select_breaks ? false : b_cross_low6 == 1) : false) or (b_trendline_nr > 5 ? b_cross_high5 == 1 or (b_select_breaks ? false : b_cross_low5 == 1) : false) or (b_trendline_nr > 4 ? b_cross_high4 == 1 or (b_select_breaks ? false : b_cross_low4 == 1) : false) or (b_trendline_nr > 3 ? b_cross_high3 == 1 or (b_select_breaks ? false : b_cross_low3 == 1) : false) or (b_trendline_nr > 2 ? b_cross_high2 == 1 or (b_select_breaks ? false : b_cross_low2 == 1) : false) or (b_trendline_nr > 1 ? b_cross_high1 == 1 or (b_select_breaks ? false : b_cross_low1 == 1) : false) or b_cross_high0 == 1 or (b_select_breaks ? false : b_cross_low0 == 1)
