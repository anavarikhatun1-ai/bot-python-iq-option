// ///// Secondary Trendlines /////

// // Trendline Extensions

b_Extension_Multiplier = b_Extensions == '  25' ? 1 : b_Extensions == '  50' ? 2 : b_Extensions == '  75' ? 3 : b_Extensions == ' 100' ? 4 : b_Extensions == ' 150' ? 6 : b_Extensions == ' 200' ? 8 : b_Extensions == ' 300' ? 12 : b_Extensions == ' 400' ? 16 : b_Extensions == ' 500' ? 20 : b_Extensions == ' 750' ? 30 : b_Extensions == '1000' ? 40 : b_Extensions == 'Infinate' ? 0 : na


// Declaration of trendline function



// Function to get trendline price for X bars ago ("0" = current value)
b_line_get_price(b__start_time, b__start_price, b__slope, b__lookback_period, b__log_chart) =>
    float b_current_price = 0.0
    b_elapsed_time = time - b__start_time  // (time-b__start_time) // Original v312
    b_current_price := b__log_chart ? b__start_price * math.exp((b_elapsed_time - b__lookback_period * b_bar_time) * b__slope) : b__start_price + (b_elapsed_time - b__lookback_period * b_bar_time) * b__slope
    b_current_price


// Function to check for trendline crosses
b_line_cross(b__check_value, b__start_time, b__start_price, b__slope, b__log_chart) =>
    float b_current_value = 0.0
    float b_previous_value = 0.0
    // Get current and previous price for the trendline
    b_current_value := b_line_get_price(b__start_time, b__start_price, b__slope, 0, b__log_chart)  // 0, b__log_chart)
    b_previous_value := b_line_get_price(b__start_time, b__start_price, b__slope, 1, b__log_chart)  //1, b__log_chart)
    // Return 1 for crossover, -1 for crossunder and 0 for no cross detected
    b_cross = b__check_value[1] < b_previous_value and b__check_value > b_current_value ? 1 : b__check_value[1] > b_previous_value and b__check_value < b_current_value ? -1 : 0
    b_cross

// Calculate pivot points
b_high_point = ta.pivothigh(b_Wicks == 'Wicks' ? high : close > open ? close : open, b_len, b_len / 2)
b_low_point = ta.pivotlow(b_Wicks == 'Wicks' ? low : close > open ? open : close, b_len, b_len / 2)

// --- SMC: Inlined Secondary High Trendline Calculation ---
var int b_high_Ax = 1
var int b_high_Bx = 1
var float b_high_By = 0.0
var float b_high_slope = 0.0

b_high_Ay = fixnan(b_high_point)
if ta.change(b_high_Ay) != 0
    int prev_Ax = b_high_Ax
    b_high_Ax := time[int(b_len / 2)]
    b_high_By := b_high_Ay[1]
    b_high_Bx := prev_Ax
    b_high_slope := log_chart ? (math.log(b_high_Ay) - math.log(b_high_By)) / (b_high_Ax - b_high_Bx) : (b_high_Ay - b_high_By) / (b_high_Ax - b_high_Bx)

var line b_high_trendline = na
var int b_high_Axbis = 0
var float b_high_Aybis = 0
var bool b_high_xtend = true
b_extension_time = b_Extension_Multiplier * b_bar_time * 25
b_high_Axbis := b_high_Ax + b_extension_time
b_high_Aybis := log_chart ? b_high_Ay * math.exp(b_extension_time * b_high_slope) : b_high_Ay + b_extension_time * b_high_slope
if b_Extension_Multiplier != 0
    b_high_xtend := false

if ta.change(b_high_Ay) != 0
    b_line_color_Rising_Falling = b_high_slope * time < 0 ? false ? b_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na : a_Color_Type == 'Colored' ? color.green : color.teal : false ? a_Color_Type == 'Colored' ? color.red : color.teal : b_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na
    b_line_color_Not_Rising_Falling = b_high_slope * time < 0 ? false ? na : a_Color_Type == 'Colored' ? color.green : color.teal : false ? a_Color_Type == 'Colored' ? color.red : color.teal : na
    b_line_color = b_Show_Secondary and not b_Rising_Upper_Falling_Lower ? b_line_color_Not_Rising_Falling : b_Show_Secondary and b_Rising_Upper_Falling_Lower ? b_line_color_Rising_Falling : na
    if not na(b_line_color)
        b_high_trendline := line.new(b_high_Bx, b_high_By, b_high_Axbis, b_high_Aybis, xloc.bar_time, extend=b_high_xtend ? extend.right : extend.none, color=b_line_color, style=b_Line_Type, width=b_width)

b_phx1 = b_high_Bx
b_phy1 = b_high_By
b_phx2 = b_high_Axbis
b_phy2 = b_high_Aybis
b_slope_high = b_high_slope


// --- SMC: Inlined Secondary Low Trendline Calculation ---
var int b_low_Ax = 1
var int b_low_Bx = 1
var float b_low_By = 0.0
var float b_low_slope = 0.0

b_low_Ay = fixnan(b_low_point)
if ta.change(b_low_Ay) != 0
    int prev_Ax = b_low_Ax
    b_low_Ax := time[int(b_len / 2)]
    b_low_By := b_low_Ay[1]
    b_low_Bx := prev_Ax
    b_low_slope := log_chart ? (math.log(b_low_Ay) - math.log(b_low_By)) / (b_low_Ax - b_low_Bx) : (b_low_Ay - b_low_By) / (b_low_Ax - b_low_Bx)

var line b_low_trendline = na
var int b_low_Axbis = 0
var float b_low_Aybis = 0
var bool b_low_xtend = true
b_low_Axbis := b_low_Ax + b_extension_time
b_low_Aybis := log_chart ? b_low_Ay * math.exp(b_extension_time * b_low_slope) : b_low_Ay + b_extension_time * b_low_slope
if b_Extension_Multiplier != 0
    b_low_xtend := false

if ta.change(b_low_Ay) != 0
    b_line_color_Rising_Falling = b_low_slope * time < 0 ? true ? b_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na : a_Color_Type == 'Colored' ? color.green : color.teal : true ? a_Color_Type == 'Colored' ? color.red : color.teal : b_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na
    b_line_color_Not_Rising_Falling = b_low_slope * time < 0 ? true ? na : a_Color_Type == 'Colored' ? color.green : color.teal : true ? a_Color_Type == 'Colored' ? color.red : color.teal : na
    b_line_color = b_Show_Secondary and not b_Rising_Upper_Falling_Lower ? b_line_color_Not_Rising_Falling : b_Show_Secondary and b_Rising_Upper_Falling_Lower ? b_line_color_Rising_Falling : na
    if not na(b_line_color)
        b_low_trendline := line.new(b_low_Bx, b_low_By, b_low_Axbis, b_low_Aybis, xloc.bar_time, extend=b_low_xtend ? extend.right : extend.none, color=b_line_color, style=b_Line_Type, width=b_width)

b_plx1 = b_low_Bx
b_ply1 = b_low_By
b_plx2 = b_low_Axbis
b_ply2 = b_low_Aybis
b_slope_low = b_low_slope

// Plot and connect pivot points
b_color_high = b_slope_high * time < 0 ? color.green : na
b_color_low = b_slope_low * time > 0 ? color.red : na

