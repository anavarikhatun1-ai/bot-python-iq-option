b_cross_low0 = not b_Rising_Upper_Falling_Lower and b_low_sl0 * time < 0 ? 0 : b_line_cross(close, b_low_x0, b_low_y0, b_low_sl0, log_chart)
b_cross_high1 = not b_Rising_Upper_Falling_Lower and b_high_sl1 * time > 0 ? 0 : b_line_cross(close, b_high_x1, b_high_y1, b_high_sl1, log_chart)
b_cross_low1 = not b_Rising_Upper_Falling_Lower and b_low_sl1 * time < 0 ? 0 : b_line_cross(close, b_low_x1, b_low_y1, b_low_sl1, log_chart)
