indicator(title='Thunderbolt 3.0', overlay=true)

// ==========================================
// INPUTS & SETTINGS
// ==========================================
showBB       = input.bool(title='Show BB', defval=false, group='Bollinger Band')
showVWAP     = input.bool(title='Show VWAP', defval=false, group='Vwap')
showEMA9     = input.bool(title='Show EMA 9', defval=true, group='EMA Lines')
showEMA15    = input.bool(title='Show EMA 15', defval=true, group='EMA Lines')
showEMA20    = input.bool(title='Show EMA 20', defval=false, group='EMA Lines')
showEMA50    = input.bool(title='Show EMA 50', defval=false, group='EMA Lines')
showEMA100   = input.bool(title='Show EMA 100', defval=false, group='EMA Lines')
showEMA200   = input.bool(title='Show EMA 200', defval=false, group='EMA Lines')

showSMA9     = input.bool(title='Show SMA-9', defval=false, group='SMA Lines')
showSMA20    = input.bool(title='Show SMA -20', defval=false, group='SMA Lines')
showSMA50    = input.bool(title='Show SMA-50', defval=false, group='SMA Lines')
showSMA100   = input.bool(title='Show SMA-100', defval=false, group='SMA Lines')

showwMA9     = input.bool(title='Show WMA-9', defval=false, group='WMA Lines')
showwMA20    = input.bool(title='Show WMA-20', defval=false, group='WMA Lines')
showwMA50    = input.bool(title='Show WMA-50', defval=false, group='WMA Lines')
showwMA100   = input.bool(title='Show WMA-100', defval=false, group='WMA Lines')

showVWMA9    = input.bool(title='Show VWMA9', defval=false, group='VWMA Lines')
showVWMA20   = input.bool(title='Show VWMA20', defval=false, group='VWMA Lines')
showVWMA50   = input.bool(title='Show VWMA50', defval=false, group='VWMA Lines')

showPSAR     = input.bool(title='Show PSAR', defval=false, group='PSAR')
showPSAR2    = input.bool(title='Show PSAR2', defval=false, group='PSAR2')

/////// Alerts ///////
alertMode    = input.string(alert.freq_once_per_bar_close, "Alerts Mode", group="Alert Frequency", options=[alert.freq_once_per_bar, alert.freq_once_per_bar_close])

// ==========================================
// BOLLINGER BANDS
// ==========================================
length = input.int(20, minval=1, group='Bollinger Band')
src = input.source(close, title='BB_Source', group='Bollinger Band')
mult = input.float(2.0, minval=0.001, maxval=50, title='BB_StdDev', group='Bollinger Band')
basis = ta.sma(src, length)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
plot(showBB ? basis : na, 'Basis', color=color.new(#872323, 0))
p1 = plot(showBB ? upper : na, 'Upper', color=color.new(color.teal, 0))
p2 = plot(showBB ? lower : na, 'Lower', color=color.new(color.teal, 0))
fill(p1, p2, title='Background', color=color.new(#198787, 95))

// ==========================================
// EMA LINES
// ==========================================
EMA9_Len = input.int(9, minval=1, title='EMA9_Length', group='EMA Lines')
EMA9_src = input.source(close, title='EMA9_Source', group='EMA Lines')
