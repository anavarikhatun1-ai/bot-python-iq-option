wMA50_src     = input.source(close, title="wMA50_Source", group = 'WMA 50')
//wMA50_offset  = input(title="wMA50_Offset", type=input.integer, defval=0, minval=-500, maxval=500)
wMA50_out = ta.wma(close, wMA50_Len)
plot(showwMA50 ? wMA50_out : na, title='wMA50', color=color.new(color.purple, 0))

wMA100_Len = input.int(100, minval=1, title='wMA100_Length', group = 'WMA 100')
wMA100_src     = input.source(close, title="wMA100_Source", group = 'WMA 100')
//wMA100_offset  = input(title="wMA100_Offset", type=input.integer, defval=0, minval=-500, maxval=500)
wMA100_out = ta.wma(close, wMA100_Len)
plot(showwMA100 ? wMA100_out : na, title='wMA100', color=color.new(color.gray, 0))

