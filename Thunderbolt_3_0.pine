var label l_t_s3 = na

y = year(timenow)
m = month(timenow)
d = dayofmonth(timenow)

// Start & End time for Today's CPR
start = timestamp(y, m, d, 9, 15)
end = start + 86400000

// Plot Today's CPR
shouldPlotToday = timenow > start

tom_start = start
tom_end = end

// Start & End time for Tomorrow's CPR
if shouldPlotToday
    tom_start := GetNextWorkingDay(start)
    tom_end := tom_start + 86400000
    tom_end


// Get series
getSeries(e, timeFrame) =>
    request.security(syminfo.tickerid, 'D', e, lookahead=barmerge.lookahead_on)

// Calculate Today's CPR
//Get High, Low and Close
H = getSeries(high[1], 'D')
L = getSeries(low[1], 'D')
C = getSeries(close[1], 'D')

// Pivot Range
P = (H + L + C) / 3
TC = (H + L) / 2
BC = P - TC + P

// Resistance Levels
R3 = H + 2 * (P - L)
R2 = P + H - L
R1 = P * 2 - L

// Support Levels
S1 = P * 2 - H
S2 = P - (H - L)
S3 = L - 2 * (H - P)


// Plot Today's CPR
if not IsHoliday(start) and not IsWeekend(start) and shouldPlotToday
    if showR3S3
        line.delete(_r3)
        _r3 := line.new(start, R3, end, R3, xloc.bar_time, color=color.new(rColor, lTransp))
    line.delete(_r2)
    _r2 := line.new(start, R2, end, R2, xloc.bar_time, color=color.new(rColor, lTransp))
    line.delete(_r1)
    _r1 := line.new(start, R1, end, R1, xloc.bar_time, color=color.new(rColor, lTransp))

    line.delete(_tc)
    _tc := line.new(start, TC, end, TC, xloc.bar_time, color=color.new(cprColor, lTransp))
    line.delete(_p)
    _p := line.new(start, P, end, P, xloc.bar_time, color=color.new(cprColor, lTransp))
    line.delete(_bc)
    _bc := line.new(start, BC, end, BC, xloc.bar_time, color=color.new(cprColor, lTransp))

    line.delete(_s1)
    _s1 := line.new(start, S1, end, S1, xloc.bar_time, color=color.new(sColor, lTransp))
    line.delete(_s2)
    _s2 := line.new(start, S2, end, S2, xloc.bar_time, color=color.new(sColor, lTransp))
    if showR3S3
        line.delete(_s3)
        _s3 := line.new(start, S3, end, S3, xloc.bar_time, color=color.new(sColor, lTransp))

// Plot Today's Labels
if not IsHoliday(start) and not IsWeekend(start) and shouldPlotToday
    if showR3S3
        label.delete(l_r3)
        l_r3 := label.new(start, R3, text='CR3', xloc=xloc.bar_time, textcolor=rColor, style=label.style_none)
    label.delete(l_r2)
    l_r2 := label.new(start, R2, text='CR2', xloc=xloc.bar_time, textcolor=rColor, style=label.style_none)
    label.delete(l_r1)
    l_r1 := label.new(start, R1, text='CR1', xloc=xloc.bar_time, textcolor=rColor, style=label.style_none)

    label.delete(l_tc)
    l_tc := label.new(start, TC, text='CTC', xloc=xloc.bar_time, textcolor=cprColor, style=label.style_none)
    label.delete(l_p)
    l_p := label.new(start, P, text='CP', xloc=xloc.bar_time, textcolor=cprColor, style=label.style_none)
    label.delete(l_bc)
    l_bc := label.new(start, BC, text='CBC', xloc=xloc.bar_time, textcolor=cprColor, style=label.style_none)

    label.delete(l_s1)
    l_s1 := label.new(start, S1, text='CS1', xloc=xloc.bar_time, textcolor=sColor, style=label.style_none)
    label.delete(l_s2)
    l_s2 := label.new(start, S2, text='CS2', xloc=xloc.bar_time, textcolor=sColor, style=label.style_none)
    if showR3S3
        label.delete(l_s3)
        l_s3 := label.new(start, S3, text='CS3', xloc=xloc.bar_time, textcolor=sColor, style=label.style_none)


// Calculate Tomorrow's CPR
// Get High, Low and Close
tH = getSeries(high, 'D')
tL = getSeries(low, 'D')
tC = getSeries(close, 'D')

// Pivot Range
tP = (tH + tL + tC) / 3
tTC = (tH + tL) / 2
tBC = tP - tTC + tP

// Resistance Levels
tR3 = tH + 2 * (tP - tL)
tR2 = tP + tH - tL
tR1 = tP * 2 - tL

// Support Levels
tS1 = tP * 2 - tH
tS2 = tP - (tH - tL)
tS3 = tL - 2 * (tH - tP)

// Plot Tomorrow's CPR
if showTomorrowCPR
    if showR3S3
        line.delete(_t_r3)
        _t_r3 := line.new(tom_start, tR3, tom_end, tR3, xloc.bar_time, color=color.new(rColor, lTransp))
    line.delete(_t_r2)
    _t_r2 := line.new(tom_start, tR2, tom_end, tR2, xloc.bar_time, color=color.new(rColor, lTransp))
    line.delete(_t_r1)
    _t_r1 := line.new(tom_start, tR1, tom_end, tR1, xloc.bar_time, color=color.new(rColor, lTransp))

    line.delete(_t_tc)
    _t_tc := line.new(tom_start, tTC, tom_end, tTC, xloc.bar_time, color=color.new(cprColor, lTransp))
    line.delete(_t_p)
    _t_p := line.new(tom_start, tP, tom_end, tP, xloc.bar_time, color=color.new(cprColor, lTransp))
    line.delete(_t_bc)
    _t_bc := line.new(tom_start, tBC, tom_end, tBC, xloc.bar_time, color=color.new(cprColor, lTransp))

    line.delete(_t_s1)
    _t_s1 := line.new(tom_start, tS1, tom_end, tS1, xloc.bar_time, color=color.new(sColor, lTransp))
    line.delete(_t_s2)
    _t_s2 := line.new(tom_start, tS2, tom_end, tS2, xloc.bar_time, color=color.new(sColor, lTransp))
    if showR3S3
        line.delete(_t_s3)
        _t_s3 := line.new(tom_start, tS3, tom_end, tS3, xloc.bar_time, color=color.new(sColor, lTransp))

// Plot Tomorrow's Labels
if showTomorrowCPR
    if showR3S3
        label.delete(l_t_r3)
        l_t_r3 := label.new(tom_start, tR3, text='CR3', xloc=xloc.bar_time, textcolor=rColor, style=label.style_none)
    label.delete(l_t_r2)
    l_t_r2 := label.new(tom_start, tR2, text='CR2', xloc=xloc.bar_time, textcolor=rColor, style=label.style_none)
    label.delete(l_t_r1)
    l_t_r1 := label.new(tom_start, tR1, text='CR1', xloc=xloc.bar_time, textcolor=rColor, style=label.style_none)

    label.delete(l_t_tc)
    l_t_tc := label.new(tom_start, tTC, text='CTC', xloc=xloc.bar_time, textcolor=cprColor, style=label.style_none)
    label.delete(l_t_p)
    l_t_p := label.new(tom_start, tP, text='CP', xloc=xloc.bar_time, textcolor=cprColor, style=label.style_none)
    label.delete(l_t_bc)
    l_t_bc := label.new(tom_start, tBC, text='CBC', xloc=xloc.bar_time, textcolor=cprColor, style=label.style_none)

    label.delete(l_t_s1)
    l_t_s1 := label.new(tom_start, tS1, text='CS1', xloc=xloc.bar_time, textcolor=sColor, style=label.style_none)
    label.delete(l_t_s2)
    l_t_s2 := label.new(tom_start, tS2, text='CS2', xloc=xloc.bar_time, textcolor=sColor, style=label.style_none)
    if showR3S3
        label.delete(l_t_s3)
        l_t_s3 := label.new(tom_start, tS3, text='CS3', xloc=xloc.bar_time, textcolor=sColor, style=label.style_none)


//Plot Historical CPR
p_r3 = plot(showHistoricalCPR ? showR3S3 ? R3 : na : na, title=' CR3', color=color.new(rColor, lTransp), style=lStyle)
p_r2 = plot(showHistoricalCPR ? R2 : na, title=' CR2', color=color.new(rColor, lTransp), style=lStyle)
p_r1 = plot(showHistoricalCPR ? R1 : na, title=' CR1', color=color.new(rColor, lTransp), style=lStyle)

p_cprTC = plot(showHistoricalCPR ? TC : na, title=' CTC', color=color.new(cprColor, lTransp), style=lStyle)
p_cprP = plot(showHistoricalCPR ? P : na, title=' CP', color=color.new(cprColor, lTransp), style=lStyle)
p_cprBC = plot(showHistoricalCPR ? BC : na, title=' CBC', color=color.new(cprColor, lTransp), style=lStyle)

s1 = plot(showHistoricalCPR ? S1 : na, title=' CS1', color=color.new(sColor, lTransp), style=lStyle)
s2 = plot(showHistoricalCPR ? S2 : na, title=' CS2', color=color.new(sColor, lTransp), style=lStyle)
s3 = plot(showHistoricalCPR ? showR3S3 ? S3 : na : na, title=' CS3', color=color.new(sColor, lTransp), style=lStyle)

fill(p_cprTC, p_cprBC, color=color.new(color.purple, fTransp))

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// RSI Settings for user
rsiSource = input.source(title='RSI Source', defval=close, group = 'Pivot High Low')
rsiLength = input.int(title='RSI Length', defval=7, group = 'Pivot High Low')
rsiOverbought = input.int(title='RSI Overbought', defval=70, minval=51, maxval=100)
rsiOvesold = input.int(title='RSI Oversold', defval=30, minval=1, maxval=49)

// RSI value based on inbuilt RSI H
rsiValue = ta.rsi(rsiSource, rsiLength)

// Get the current state
isOverbought = rsiValue >= rsiOverbought
isOversold = rsiValue <= rsiOvesold

// State of the last extreme 0 for initialization, 1 = overbought, 2 = oversold
var laststate = 0

// Highest and Lowest prices since the last state change
var hh = low
var ll = high

// Labels
var label labelll = na
var label labelhh = na

// Swing lines
var line line_up = na
var line line_down = na

var last_actual_label_hh_price = 0.0
var last_actual_label_ll_price = 0.0

buy_alert = false
sell_alert = false


// FUNCTIONS
obLabelText() =>
    'Sell'
//plot(last_actual_label_hh_price)
osLabelText() =>
    'Buy'

// Create oversold or overbought label
createOverBoughtLabel(isIt) =>
    if isIt
        label.new(x=bar_index, y=na, yloc=yloc.abovebar, style=label.style_label_down, color=color.red, size=size.tiny, text=obLabelText())
    else
        label.new(x=bar_index, y=na, yloc=yloc.belowbar, style=label.style_label_up, color=color.green, size=size.tiny, text=osLabelText())


// Move the oversold swing and label
moveOversoldLabel() =>
    label.set_x(labelll, bar_index)
    label.set_y(labelll, low)
    label.set_text(labelll, osLabelText())
    line.set_x1(line_down, bar_index)
    line.set_y1(line_down, low)

moveOverBoughtLabel() =>
    label.set_x(labelhh, bar_index)
    label.set_y(labelhh, high)
    label.set_text(labelhh, obLabelText())
    line.set_x1(line_up, bar_index)
    line.set_y1(line_up, high)

// We go from oversold straight to overbought NEW DRAWINGS CREATED HERE
if laststate == 2 and isOverbought
    hh := high
    labelhh := createOverBoughtLabel(true)
    last_actual_label_ll_price := label.get_y(labelll)
    labelll_ts = label.get_x(labelll)
    labelll_price = label.get_y(labelll)
    line_up := line.new(x1=bar_index, y1=high, x2=labelll_ts, y2=labelll_price, width=1)
    sell_alert := true
    line_up

// We go from overbought straight to oversold  NEW DRAWINGS CREATED HERE
if laststate == 1 and isOversold
    ll := low
    labelll := createOverBoughtLabel(false)
    last_actual_label_hh_price := label.get_y(labelhh)
    labelhh_ts = label.get_x(labelhh)
    labelhh_price = label.get_y(labelhh)
    line_down := line.new(x1=bar_index, y1=high, x2=labelhh_ts, y2=labelhh_price, width=1)
    buy_alert := true
    line_down


// If we are overbought
if isOverbought
    if high >= hh
        hh := high
        moveOverBoughtLabel()
        sell_alert := true
    laststate := 1
    laststate

// If we are oversold
if isOversold
    if low <= ll
        ll := low
        moveOversoldLabel()
        buy_alert := true
    laststate := 2
    laststate


// If last state was overbought and we are overbought
if laststate == 1 and isOverbought
    if hh <= high
        hh := high
        moveOverBoughtLabel()
        sell_alert := true

//If we are oversold and the last state was oversold, move the drawings to the lowest price
if laststate == 2 and isOversold
    if low <= ll
        ll := low
        moveOversoldLabel()
        buy_alert := true


// If last state was overbought
if laststate == 1
    if hh <= high
        hh := high
        moveOverBoughtLabel()
        sell_alert := true

// If last stare was oversold
if laststate == 2
    if ll >= low
        ll := low
        moveOversoldLabel()
        buy_alert := true

//////////////////////////////////////////////////////FIB Retracement///////////////////////////////////////////////////////////
max_bars_back=5000


Fibs = input.string('OFF Fibs', options=['Plot Fibs based on Lookback', 'Plot Fibs based on Price Input', 'OFF Fibs'], title='Fibonacci Plot Type', group = 'Fib Retracement')

FIBS = Fibs == 'Plot Fibs based on Lookback' ? 1 : Fibs == 'Plot Fibs based on Price Input' ? 2 : Fibs== 'OFF Fibs' ? 3: na

Foption = input.string(defval='1. Candles', title='Fibonacci Plot Lookback Type', options=['2. Days', '1. Candles'], group = 'Fib Retracement')
FP = input.int(defval=100, title='Days/Candles to Lookback', group = 'Fib Retracement')
Reverse = input.bool(defval=false, title='Reverse Fibonacci Levels?', group = 'Fib Retracement')
ExtraFibs = input.bool(false, 'Show 0.886 and 1.113 Fibs')
Display= display.none

Note = input.bool(true, '════ 𝗙𝗶𝗯𝘀 𝗯𝗮𝘀𝗲𝗱 𝗼𝗻 𝗣𝗿𝗶𝗰𝗲 𝗜𝗻𝗽𝘂𝘁 ════')
High = input.float(0., minval=0, title='High - Enter Value')
Low = input.float(-1., minval=-1, title='Low - Enter Value')


Note2 = input.bool(true, '══════ 𝗙𝗶𝗯 𝗟𝗶𝗻𝗲/𝗟𝗮𝗯𝗲𝗹 𝗦𝘁𝘆𝗹𝗲 ══════')
Bull_Color = input.color(#008000, title='Support Fibs Color')
Bear_Color = input.color(#ff0000, title='Resistance Fibs Color')
CurrentFib = input.bool(false, 'Show Fib Level of Current Price')
Current_Color = input.color(color.orange, title='Current Fib Label Color')
LineStyle = input.string('Dotted', options=['Dotted', 'Solid'], title='Fib Line Style')
LineWidth = input.int(1, minval=1, maxval=3, title='Fib Line Width')
Ext = input.bool(false, 'Extend Lines Left')


// Transparency = input("Low", options = ["High", "Medium", "Low"], title="Fib Line Transparency")



BullColor = Bull_Color  //Transparency == "High"?color.new(#008000,75):Transparency == "Medium"?color.new(#008000,50):Bull_Color
BearColor = Bear_Color  //Transparency == "High"?color.new(#ff0000,75):Transparency == "Medium"?color.new(#ff0000,50):Bear_Color


FPeriod = timeframe.isintraday and Foption == '2. Days' ? 1440 / timeframe.multiplier * FP : timeframe.isdaily and Foption == '2. Days' ? FP / timeframe.multiplier : timeframe.isweekly and Foption == '2. Days' ? FP / (7 * timeframe.multiplier) : timeframe.ismonthly and Foption == '2. Days' ? FP / (28 * timeframe.multiplier) : Foption == '1. Candles' ? FP : 100


Fhigh = FIBS == 1 ? ta.highest(high, int(FPeriod)) : FIBS == 2 and High == 0 ? ta.highest(high, 100) : FIBS == 2 and High != 0 ? High : na
Flow = FIBS == 1 ? ta.lowest(low, int(FPeriod)) : FIBS == 2 and Low == -1 ? ta.lowest(low, 100) : FIBS == 2 and High != -1 ? Low : na
FH = FIBS == 1 ? ta.highestbars(high, FPeriod) : 1
FL = FIBS == 1 ? ta.lowestbars(low, FPeriod) : 2
revfibs = not Reverse ? FL > FH : FL < FH



Fib_x(n) =>
    revfibs ? (Fhigh - Flow) * n + Flow : Fhigh - (Fhigh - Flow) * n

Current = revfibs ? (close - Flow) / (Fhigh - Flow) : (Fhigh - close) / (Fhigh - Flow)

var label Current_Fib_Label = na
label.delete(Current_Fib_Label)

if CurrentFib and barstate.islast
    Current_Fib_Label := label.new(bar_index, close, str.tostring(Current, '##.##'), textcolor=Current_Color, color=color.new(#000000, 100), style=label.style_label_left, yloc=yloc.price)
    Current_Fib_Label




EXTEND = Ext ? extend.left : extend.none
STYLE = LineStyle == 'Dotted' ? line.style_dotted : line.style_solid
WIDTH = LineWidth

BB = FIBS == 1 ? FL < FH ? bar_index[-FL] : bar_index[-FH] : FIBS == 2 ? bar_index[50] : bar_index[50]

Fib_line(x) =>
    var line ln = na
    line.delete(ln)
    ln := line.new(BB, x, bar_index, x, color=close > x ? BullColor : BearColor, extend=EXTEND, style=STYLE, width=WIDTH)
    ln



Fib_label(x, _txt) =>
    var label lbl = na
    label.delete(lbl)
    lbl := label.new(bar_index, x, _txt + str.tostring(x, '##.########') + ' )', textcolor=close > x ? BullColor : BearColor, color=color.new(#000000, 100), style=label.style_label_left, yloc=yloc.price)
    lbl



Fib0 = Fib_line(Fib_x(0))
Fib236 = Fib_line(Fib_x(0.236))
Fib382 = Fib_line(Fib_x(0.382))
Fib500 = Fib_line(Fib_x(0.500))
Fib618 = Fib_line(Fib_x(0.618))
Fib786 = Fib_line(Fib_x(0.786))
Fib1000 = Fib_line(Fib_x(1.000))

Fib886 = ExtraFibs ? Fib_line(Fib_x(0.886)) : na

if FIBS == 2

    Fib1113 = ExtraFibs ? Fib_line(Fib_x(1.113)) : na

    Fib1272 = Fib_line(Fib_x(1.272))
    Fib1618 = Fib_line(Fib_x(1.618))
    Fib2000 = Fib_line(Fib_x(2.000))
    Fib2236 = Fib_line(Fib_x(2.236))
    Fib2618 = Fib_line(Fib_x(2.618))
    Fib3236 = Fib_line(Fib_x(3.236))
    Fib3618 = Fib_line(Fib_x(3.618))
    Fib4236 = Fib_line(Fib_x(4.236))
    Fib4618 = Fib_line(Fib_x(4.618))
    Fib4618


LFib0 = Fib_label(Fib_x(0), '0 ( ')
LFib236 = Fib_label(Fib_x(0.236), '0.236 ( ')
LFib382 = Fib_label(Fib_x(0.382), '0.382 ( ')
LFib500 = Fib_label(Fib_x(0.500), '0.500 ( ')
LFib618 = Fib_label(Fib_x(0.618), '0.618 ( ')
LFib786 = Fib_label(Fib_x(0.786), '0.786 ( ')
LFib1000 = Fib_label(Fib_x(1.000), '1.000 ( ')

LFib886 = ExtraFibs ? Fib_label(Fib_x(0.886), '0.886 ( ') : na


if FIBS == 2

    LFib1113 = ExtraFibs ? Fib_label(Fib_x(1.113), '1.113 ( ') : na

    LFib1272 = Fib_label(Fib_x(1.272), '1.272 ( ')
    LFib1618 = Fib_label(Fib_x(1.618), '1.618 ( ')
    LFib2000 = Fib_label(Fib_x(2.000), '2.000 ( ')
    LFib2236 = Fib_label(Fib_x(2.236), '2.236 ( ')
    LFib2618 = Fib_label(Fib_x(2.618), '2.618 ( ')
    LFib3236 = Fib_label(Fib_x(3.236), '3.236 ( ')
    LFib3618 = Fib_label(Fib_x(3.618), '3.618 ( ')
    LFib4236 = Fib_label(Fib_x(4.236), '4.236 ( ')
    LFib4618 = Fib_label(Fib_x(4.618), '4.618 ( ')
    LFib4618


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Pivot High Low Alerts
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// [Alertcondition commented out for Strategy compatibility] alertcondition(buy_alert, title='Alert - Pivot Buy', message='Pivot Buy Signal')
// [Alertcondition commented out for Strategy compatibility] alertcondition(sell_alert, title='Alert - Pivot Sell', message='Pivot Sell Signal')

if buy_alert
    alert('Pivot Buy Signal on ' + timeframe.period + ' chart. Price is ' + str.tostring(close), alertMode)

if sell_alert
    alert('Pivot Sell Signal on ' + timeframe.period + ' chart. Price is ' + str.tostring(close), alertMode)

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ==================== SMC: LIQUIDITY SWEEP -> RECLAIM -> MSS STRATEGY ====================
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// --- 1. CONFIGURABLE INPUTS ---
pivotLen = input.int(3, minval=1, maxval=10, title="Pivot Length", group="SMC: Pivot/Structure")
structureMode = input.string("Auto", title="Structure Mode", options=["Auto", "Bullish", "Bearish"], group="SMC: Pivot/Structure")
mssRequired = input.bool(true, title="Require MSS (Market Structure Shift)?", group="SMC: Pivot/Structure")
bosRequired = input.bool(false, title="Require BOS (Break of Structure) after MSS?", group="SMC: Pivot/Structure")
mssLookback = input.int(9, minval=1, title="Max Bars to Search Pre-Sweep Pivot", group="SMC: Pivot/Structure")
breakMode = input.string("Close", title="Structure Break Mode", options=["Close", "Wick", "Buffer_ticks", "Buffer_%"], group="SMC: Pivot/Structure")
breakBuffer = input.float(0.0, title="Break Buffer (Ticks/Percent)", group="SMC: Pivot/Structure")

sweepEnabled = input.bool(true, title="Enable Liquidity Sweep Detection", group="SMC: Sweep Detection")
minSweepDist = input.float(0.0, title="Min Sweep Distance (ticks)", group="SMC: Sweep Detection")
maxSweepDist = input.float(999999.0, title="Max Sweep Distance (ticks)", group="SMC: Sweep Detection")
atrPeriod = input.int(14, title="ATR Period for Volatility", group="SMC: Sweep Detection")
sweepWickPct = input.float(50.0, title="Min Sweep Wick % of Bar Range", minval=0.0, maxval=100.0, group="SMC: Sweep Detection")
sweepVolMult = input.float(1.0, title="Sweep Volume Multiplier", minval=0.0, group="SMC: Sweep Detection")
allowSameBarReclaim = input.bool(false, title="Allow Same-Bar Reclaim?", group="SMC: Sweep Detection")

reclaimRequired = input.bool(true, title="Reclaim Required?", group="SMC: Reclaim")
reclaimWindow = input.int(3, minval=1, title="Max Bars for Reclaim Window", group="SMC: Reclaim")
reclaimBuffer = input.float(0.0, title="Reclaim Buffer (Ticks)", group="SMC: Reclaim")
reclaimClose = input.bool(true, title="Require Close Beyond Pivot for Reclaim?", group="SMC: Reclaim")
reclaimMinPct = input.float(0.0, title="Min % Beyond Pivot for Reclaim", group="SMC: Reclaim")

mssWindow = input.int(5, minval=1, title="Max Bars for MSS Window", group="SMC: MSS/CHOCH")
mssBuffer = input.float(0.0, title="MSS Buffer (Ticks)", group="SMC: MSS/CHOCH")
mssBreakByClose = input.bool(true, title="Require Close Beyond Pivot for MSS?", group="SMC: MSS/CHOCH")
minMSSCandle = input.float(0.0, title="Min MSS Candle % of ATR (0=Disabled)", group="SMC: MSS/CHOCH")

useTrendFilter = input.bool(false, title="Use HTF Trend Filter?", group="SMC: Trend/HTF Filter")
htfTimeframe = input.timeframe("60", title="HTF Timeframe", group="SMC: Trend/HTF Filter")
emaFilter = input.bool(false, title="Use HTF EMA Filter?", group="SMC: Trend/HTF Filter")
emaFast = input.int(50, title="HTF Fast EMA Length", group="SMC: Trend/HTF Filter")
emaSlow = input.int(200, title="HTF Slow EMA Length", group="SMC: Trend/HTF Filter")
rsiFilter = input.bool(false, title="Use HTF RSI Filter?", group="SMC: Trend/HTF Filter")
rsiLength_htf = input.int(14, title="HTF RSI Length", group="SMC: Trend/HTF Filter")
rsiHigh_htf = input.int(70, title="HTF RSI Overbought Threshold", group="SMC: Trend/HTF Filter")
rsiLow_htf = input.int(30, title="HTF RSI Oversold Threshold", group="SMC: Trend/HTF Filter")
vwapFilter = input.bool(false, title="Use HTF VWAP Filter?", group="SMC: Trend/HTF Filter")

sessionFilter = input.bool(false, title="Enable Session Filter?", group="SMC: Session Filter")
tradeSession = input.string("0930-1600", title="Trade Session (e.g. 0930-1600)", group="SMC: Session Filter")
timezone_smc = input.string("exchange", title="Timezone", group="SMC: Session Filter")

enterLong = input.bool(true, title="Allow Long Entries?", group="SMC: Entry Settings")
enterShort = input.bool(true, title="Allow Short Entries?", group="SMC: Entry Settings")
entryType = input.string("Market", title="Entry Order Type", options=["Market", "Limit"], group="SMC: Entry Settings")
entryBuffer = input.float(0.0, title="Limit Entry Buffer (Ticks)", group="SMC: Entry Settings")
oneEntryPerSetup = input.bool(true, title="One Entry Per Setup?", group="SMC: Entry Settings")
cooldownBars = input.int(0, minval=0, title="Cooldown Bars After Signal", group="SMC: Entry Settings")

useFixedQty = input.bool(true, title="Use Fixed Quantity (True) or Risk% (False)?", group="SMC: Risk & Sizing")
qty_smc = input.float(1.0, title="Fixed Position Quantity", group="SMC: Risk & Sizing")
riskPercent = input.float(1.0, title="Risk Percentage per Trade", minval=0.1, maxval=100.0, group="SMC: Risk & Sizing")
maxPositions = input.int(1, title="Max Positions", group="SMC: Risk & Sizing")

stopMethod = input.string("PivotExtreme", title="Stop Loss Method", options=["PivotExtreme", "ATR", "Fixed%", "FixedTicks"], group="SMC: Stop Loss")
slBufferType = input.string("Ticks", title="PivotExtreme Buffer Type", options=["Ticks", "ATR Multiplier"], group="SMC: Stop Loss")
slBuffer = input.float(2.0, title="PivotExtreme Buffer Value", group="SMC: Stop Loss")
atrSLMult = input.float(2.0, title="ATR SL Multiplier", group="SMC: Stop Loss")
slPercent = input.float(1.0, title="Fixed SL Percent (%)", group="SMC: Stop Loss")
slTicks = input.float(50.0, title="Fixed SL Ticks", group="SMC: Stop Loss")

tpMethod = input.string("RiskReward", title="Take Profit Method", options=["RiskReward", "ATR", "Fixed%", "PivotTarget"], group="SMC: Take Profit")
rrMultiplier = input.float(2.0, title="Risk/Reward Multiplier", group="SMC: Take Profit")
atrTPMult = input.float(4.0, title="ATR TP Multiplier", group="SMC: Take Profit")
tpPercent = input.float(2.0, title="Fixed TP Percent (%)", group="SMC: Take Profit")
usePartialExit = input.bool(false, title="Use Multi-TP Partial Exits?", group="SMC: Take Profit")
tp1Percent = input.float(50.0, title="TP1 Exit Quantity (%)", group="SMC: Take Profit")
tp1RR = input.float(1.0, title="TP1 Risk/Reward Ratio", group="SMC: Take Profit")
tp2Percent = input.float(30.0, title="TP2 Exit Quantity (%)", group="SMC: Take Profit")
tp2RR = input.float(2.0, title="TP2 Risk/Reward Ratio", group="SMC: Take Profit")
moveToBreakevenAtTP1 = input.bool(false, title="Move Stop to Breakeven at TP1?", group="SMC: Take Profit")

showPivots = input.bool(true, title="Show Confirmed PH/PL Labels?", group="SMC: Visuals")
showSweeps = input.bool(true, title="Show Sweep Markers?", group="SMC: Visuals")
showReclaims = input.bool(true, title="Show Reclaim Markers?", group="SMC: Visuals")
showMSS = input.bool(true, title="Show MSS Markers?", group="SMC: Visuals")
showBOS = input.bool(false, title="Show BOS Markers?", group="SMC: Visuals")
showSLTP = input.bool(true, title="Show Active SL/TP Target Lines?", group="SMC: Visuals")


// --- 2. GLOBAL SCOPE VARIABLES & HELPER FUNCTIONS ---
security_no_repaint(sym, tf, src) =>
    request.security(sym, tf, src[1], barmerge.gaps_off, barmerge.lookahead_on)

atr_val = ta.atr(atrPeriod)
vol_avg_20 = ta.sma(volume, 20)

// HTF Trend calculation
ema_fast_val = security_no_repaint(syminfo.tickerid, htfTimeframe, ta.ema(close, emaFast))
ema_slow_val = security_no_repaint(syminfo.tickerid, htfTimeframe, ta.ema(close, emaSlow))
rsi_htf_val = security_no_repaint(syminfo.tickerid, htfTimeframe, ta.rsi(close, rsiLength_htf))
vwap_htf_val = security_no_repaint(syminfo.tickerid, htfTimeframe, ta.vwap)

trend_long_ok = true
trend_short_ok = true

if useTrendFilter
    if emaFilter
        trend_long_ok := trend_long_ok and (ema_fast_val > ema_slow_val)
        trend_short_ok := trend_short_ok and (ema_fast_val < ema_slow_val)
    if rsiFilter
        trend_long_ok := trend_long_ok and (rsi_htf_val < rsiHigh_htf)
        trend_short_ok := trend_short_ok and (rsi_htf_val > rsiLow_htf)
    if vwapFilter
        trend_long_ok := trend_long_ok and (close > vwap_htf_val)
        trend_short_ok := trend_short_ok and (close < vwap_htf_val)


// --- 3. PIVOT DETECTION & HISTORICAL TRACKING ---
pivot_high = ta.pivothigh(high, pivotLen, pivotLen)
pivot_low = ta.pivotlow(low, pivotLen, pivotLen)

var float last_p_high_val = na
var int last_p_high_bar = na
var float last_p_low_val = na
var int last_p_low_bar = na

// Arrays for historical confirmed pivots to support search
var float[] past_p_high_vals = array.new_float(0)
var int[] past_p_high_bars = array.new_int(0)
var float[] past_p_low_vals = array.new_float(0)
var int[] past_p_low_bars = array.new_int(0)

if not na(pivot_high) and barstate.isconfirmed
    last_p_high_val := high[pivotLen]
    last_p_high_bar := bar_index - pivotLen
    array.push(past_p_high_vals, last_p_high_val)
    array.push(past_p_high_bars, last_p_high_bar)
    if array.size(past_p_high_vals) > 50
        array.shift(past_p_high_vals)
        array.shift(past_p_high_bars)

if not na(pivot_low) and barstate.isconfirmed
    last_p_low_val := low[pivotLen]
    last_p_low_bar := bar_index - pivotLen
    array.push(past_p_low_vals, last_p_low_val)
    array.push(past_p_low_bars, last_p_low_bar)
    if array.size(past_p_low_vals) > 50
        array.shift(past_p_low_vals)
        array.shift(past_p_low_bars)

find_prior_pivot_high(sweep_bar) =>
    float p_val = na
    int p_bar = na
    int sz = array.size(past_p_high_bars)
    if sz > 0
        for i = sz - 1 to 0 by -1
            int bar_idx = array.get(past_p_high_bars, i)
            if bar_idx < sweep_bar
                p_val := array.get(past_p_high_vals, i)
                p_bar := bar_idx
                break
    [p_val, p_bar]

find_prior_pivot_low(sweep_bar) =>
    float p_val = na
    int p_bar = na
    int sz = array.size(past_p_low_bars)
    if sz > 0
        for i = sz - 1 to 0 by -1
            int bar_idx = array.get(past_p_low_bars, i)
            if bar_idx < sweep_bar
                p_val := array.get(past_p_low_vals, i)
                p_bar := bar_idx
                break
    [p_val, p_bar]


// --- 4. STATE MACHINE SEQUENCE LOGIC ---
var int buy_state = 0  // 0: None, 1: Sweep, 2: Reclaim, 3: MSS
var int sell_state = 0

// Setup tracking variables
var float buy_sweep_low = na
var int buy_sweep_bar = na
var float buy_sweep_lowest_low = na
var int buy_reclaim_bar = na
var float buy_mss_high = na

var float sell_sweep_high = na
var int sell_sweep_bar = na
var float sell_sweep_highest_high = na
var int sell_reclaim_bar = na
var float sell_mss_low = na

// Session tracking
in_session = not sessionFilter or not na(time(timeframe.period, tradeSession, timezone_smc))
var bool was_in_session = false

// Cooldown tracking
var int last_buy_trade_bar = 0
var int last_sell_trade_bar = 0

// Entry signal flags
buy_entry_signal = false
sell_entry_signal = false

if barstate.isconfirmed
    // Reset setups on session boundary transition
    if sessionFilter and was_in_session and not in_session
        buy_state := 0
        sell_state := 0
    was_in_session := in_session

    // ==================== BULLISH (BUY) STATE MACHINE ====================
    if buy_state == 0
        // Detect Sweep
        if sweepEnabled and not na(last_p_low_val) and bar_index > last_p_low_bar and in_session
            if low < last_p_low_val
                dist_ticks = (last_p_low_val - low) / syminfo.mintick
                wick_size = math.min(open, close) - low
                bar_range = high - low
                wick_pct = bar_range > 0 ? (wick_size / bar_range) * 100.0 : 0.0
                vol_ok = volume >= sweepVolMult * vol_avg_20

                if dist_ticks >= minSweepDist and dist_ticks <= maxSweepDist and wick_pct >= sweepWickPct and vol_ok
                    buy_state := 1
                    buy_sweep_low := last_p_low_val
                    buy_sweep_bar := bar_index
                    buy_sweep_lowest_low := low
                    sell_state := 0 // Opposite sweep cancels bearish setup

    elif buy_state == 1
        // Confirm Reclaim
        if bar_index - buy_sweep_bar > reclaimWindow or close < buy_sweep_lowest_low
            buy_state := 0
        else
            reclaim_cond = close > buy_sweep_low + reclaimBuffer * syminfo.mintick
            same_bar_ok = allowSameBarReclaim or bar_index > buy_sweep_bar
            pct_ok = (close - buy_sweep_low) / buy_sweep_low * 100.0 >= reclaimMinPct

            if reclaim_cond and same_bar_ok and pct_ok
                buy_state := 2
                buy_reclaim_bar := bar_index

    elif buy_state == 2
        // Confirm MSS
        if bar_index - buy_reclaim_bar > mssWindow or close < buy_sweep_lowest_low
            buy_state := 0
        else
            [mss_p_high, mss_p_high_bar] = find_prior_pivot_high(buy_sweep_bar)
            if not na(mss_p_high) and buy_sweep_bar - mss_p_high_bar <= mssLookback
                if not mssRequired
                    buy_state := 3
                    buy_mss_high := high
                else
                    break_val = mssBreakByClose ? close : high
                    break_cond = break_val > mss_p_high + mssBuffer * syminfo.mintick
                    candle_ok = minMSSCandle == 0.0 or (high - low) >= (minMSSCandle / 100.0) * atr_val

                    if break_cond and candle_ok
                        buy_state := 3
                        buy_mss_high := high

    elif buy_state == 3
        // Waiting for BOS or immediate Entry
        if not bosRequired
            if bar_index > last_buy_trade_bar + cooldownBars
                buy_entry_signal := true
            buy_state := 0
        else
            // BOS requirement: close above the MSS candle high
            if close > buy_mss_high
                if bar_index > last_buy_trade_bar + cooldownBars
                    buy_entry_signal := true
                buy_state := 0
            else if bar_index - buy_reclaim_bar > mssWindow + 5 or close < buy_sweep_lowest_low
                buy_state := 0

    // ==================== BEARISH (SELL) STATE MACHINE ====================
    if sell_state == 0
        // Detect Sweep
        if sweepEnabled and not na(last_p_high_val) and bar_index > last_p_high_bar and in_session
            if high > last_p_high_val
                dist_ticks = (high - last_p_high_val) / syminfo.mintick
                wick_size = high - math.max(open, close)
                bar_range = high - low
                wick_pct = bar_range > 0 ? (wick_size / bar_range) * 100.0 : 0.0
                vol_ok = volume >= sweepVolMult * vol_avg_20

                if dist_ticks >= minSweepDist and dist_ticks <= maxSweepDist and wick_pct >= sweepWickPct and vol_ok
                    sell_state := 1
                    sell_sweep_high := last_p_high_val
                    sell_sweep_bar := bar_index
                    sell_sweep_highest_high := high
                    buy_state := 0 // Opposite sweep cancels bullish setup

    elif sell_state == 1
        // Confirm Reclaim
        if bar_index - sell_sweep_bar > reclaimWindow or close > sell_sweep_highest_high
            sell_state := 0
        else
            reclaim_cond = close < sell_sweep_high - reclaimBuffer * syminfo.mintick
            same_bar_ok = allowSameBarReclaim or bar_index > sell_sweep_bar
            pct_ok = (sell_sweep_high - close) / sell_sweep_high * 100.0 >= reclaimMinPct

            if reclaim_cond and same_bar_ok and pct_ok
                sell_state := 2
                sell_reclaim_bar := bar_index

    elif sell_state == 2
        // Confirm MSS
        if bar_index - sell_reclaim_bar > mssWindow or close > sell_sweep_highest_high
            sell_state := 0
        else
            [mss_p_low, mss_p_low_bar] = find_prior_pivot_low(sell_sweep_bar)
            if not na(mss_p_low) and sell_sweep_bar - mss_p_low_bar <= mssLookback
                if not mssRequired
                    sell_state := 3
                    sell_mss_low := low
                else
                    break_val = mssBreakByClose ? close : low
                    break_cond = break_val < mss_p_low - mssBuffer * syminfo.mintick
                    candle_ok = minMSSCandle == 0.0 or (high - low) >= (minMSSCandle / 100.0) * atr_val

                    if break_cond and candle_ok
                        sell_state := 3
                        sell_mss_low := low

    elif sell_state == 3
        // Waiting for BOS or immediate Entry
        if not bosRequired
            if bar_index > last_sell_trade_bar + cooldownBars
                sell_entry_signal := true
            sell_state := 0
        else
            // BOS requirement: close below the MSS candle low
            if close < sell_mss_low
                if bar_index > last_sell_trade_bar + cooldownBars
                    sell_entry_signal := true
                sell_state := 0
            else if bar_index - sell_reclaim_bar > mssWindow + 5 or close > sell_sweep_highest_high
                sell_state := 0


// --- 5. COMBINED FILTERED SIGNALS ---
buy_entry_signal_filtered = buy_entry_signal and trend_long_ok
sell_entry_signal_filtered = sell_entry_signal and trend_short_ok


// --- 6. RISK MANAGEMENT & ORDER EXECUTION ---
// SL and TP Calculation variables on entry bars
float sl_long_calc = na
float tp_long_calc = na
float final_qty_long = qty_smc

if buy_entry_signal_filtered
    if stopMethod == "PivotExtreme"
        sl_long_calc := buy_sweep_lowest_low - (slBufferType == "Ticks" ? slBuffer * syminfo.mintick : slBuffer * atr_val)
    elif stopMethod == "ATR"
        sl_long_calc := close - atrSLMult * atr_val
    elif stopMethod == "Fixed%"
        sl_long_calc := close * (1.0 - slPercent / 100.0)
    elif stopMethod == "FixedTicks"
        sl_long_calc := close - slTicks * syminfo.mintick

    if not na(sl_long_calc) and sl_long_calc >= close
        sl_long_calc := close - 10 * syminfo.mintick

    if not useFixedQty and not na(sl_long_calc) and close > sl_long_calc
        risk_amt = strategy.equity * (riskPercent / 100.0)
        risk_per_share = close - sl_long_calc
        final_qty_long := risk_per_share > 0 ? risk_amt / risk_per_share : qty_smc

    if tpMethod == "RiskReward"
        tp_long_calc := close + rrMultiplier * (close - sl_long_calc)
    elif tpMethod == "ATR"
        tp_long_calc := close + atrTPMult * atr_val
    elif tpMethod == "Fixed%"
        tp_long_calc := close * (1.0 + tpPercent / 100.0)
    elif tpMethod == "PivotTarget"
        tp_long_calc := not na(last_p_high_val) ? last_p_high_val : close + 2.0 * atr_val

    if not na(tp_long_calc) and tp_long_calc <= close
        tp_long_calc := close + 20 * syminfo.mintick

float sl_short_calc = na
float tp_short_calc = na
float final_qty_short = qty_smc

if sell_entry_signal_filtered
    if stopMethod == "PivotExtreme"
        sl_short_calc := sell_sweep_highest_high + (slBufferType == "Ticks" ? slBuffer * syminfo.mintick : slBuffer * atr_val)
    elif stopMethod == "ATR"
        sl_short_calc := close + atrSLMult * atr_val
    elif stopMethod == "Fixed%"
        sl_short_calc := close * (1.0 + slPercent / 100.0)
    elif stopMethod == "FixedTicks"
        sl_short_calc := close + slTicks * syminfo.mintick

    if not na(sl_short_calc) and sl_short_calc <= close
        sl_short_calc := close + 10 * syminfo.mintick

    if not useFixedQty and not na(sl_short_calc) and sl_short_calc > close
        risk_amt = strategy.equity * (riskPercent / 100.0)
        risk_per_share = sl_short_calc - close
        final_qty_short := risk_per_share > 0 ? risk_amt / risk_per_share : qty_smc

    if tpMethod == "RiskReward"
        tp_short_calc := close - rrMultiplier * (sl_short_calc - close)
    elif tpMethod == "ATR"
        tp_short_calc := close - atrTPMult * atr_val
    elif tpMethod == "Fixed%"
        tp_short_calc := close * (1.0 - tpPercent / 100.0)
    elif tpMethod == "PivotTarget"
        tp_short_calc := not na(last_p_low_val) ? last_p_low_val : close - 2.0 * atr_val

    if not na(tp_short_calc) and tp_short_calc >= close
        tp_short_calc := close - 20 * syminfo.mintick

// Persistent Trade state tracking
var float active_sl = na
var float active_tp = na
var float tp1_target = na
var float tp2_target = na
var bool tp1_hit = false
var bool tp2_hit = false
var float entry_size = 0.0

if buy_entry_signal_filtered and enterLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=final_qty_long)
    active_sl := sl_long_calc
    active_tp := tp_long_calc
    tp1_target := close + tp1RR * (close - sl_long_calc)
    tp2_target := close + tp2RR * (close - sl_long_calc)
    tp1_hit := false
    tp2_hit := false
    entry_size := final_qty_long
    last_buy_trade_bar := bar_index

if sell_entry_signal_filtered and enterShort and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=final_qty_short)
    active_sl := sl_short_calc
    active_tp := tp_short_calc
    tp1_target := close - tp1RR * (sl_short_calc - close)
    tp2_target := close - tp2RR * (sl_short_calc - close)
    tp1_hit := false
    tp2_hit := false
    entry_size := final_qty_short
    last_sell_trade_bar := bar_index

// Manage exits dynamically
if strategy.position_size > 0
    if usePartialExit and not tp1_hit and strategy.position_size <= entry_size * (1.0 - tp1Percent / 100.0) + 0.01
        tp1_hit := true
        if moveToBreakevenAtTP1
            active_sl := strategy.position_avg_price

    if usePartialExit and not tp2_hit and strategy.position_size <= entry_size * (1.0 - (tp1Percent + tp2Percent) / 100.0) + 0.01
        tp2_hit := true

    if usePartialExit
        if not tp1_hit
            strategy.exit("TP1_L", "Long", qty_percent=tp1Percent, limit=tp1_target, stop=active_sl)
        if not tp2_hit
            strategy.exit("TP2_L", "Long", qty_percent=tp2Percent, limit=tp2_target, stop=active_sl)
        strategy.exit("Exit Long", "Long", limit=active_tp, stop=active_sl)
    else
        strategy.exit("Exit Long", "Long", limit=active_tp, stop=active_sl)

if strategy.position_size < 0
    if usePartialExit and not tp1_hit and math.abs(strategy.position_size) <= entry_size * (1.0 - tp1Percent / 100.0) + 0.01
        tp1_hit := true
        if moveToBreakevenAtTP1
            active_sl := strategy.position_avg_price

    if usePartialExit and not tp2_hit and math.abs(strategy.position_size) <= entry_size * (1.0 - (tp1Percent + tp2Percent) / 100.0) + 0.01
        tp2_hit := true

    if usePartialExit
        if not tp1_hit
            strategy.exit("TP1_S", "Short", qty_percent=tp1Percent, limit=tp1_target, stop=active_sl)
        if not tp2_hit
            strategy.exit("TP2_S", "Short", qty_percent=tp2Percent, limit=tp2_target, stop=active_sl)
        strategy.exit("Exit Short", "Short", limit=active_tp, stop=active_sl)
    else
        strategy.exit("Exit Short", "Short", limit=active_tp, stop=active_sl)


// --- 7. VISUALIZATIONS ---
// Confirmed Pivot Labels
if not na(pivot_high) and showPivots and barstate.isconfirmed
    label.new(bar_index - pivotLen, high[pivotLen], "PH", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)

if not na(pivot_low) and showPivots and barstate.isconfirmed
    label.new(bar_index - pivotLen, low[pivotLen], "PL", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)

// Plot Setup States Shapes
plotshape(showSweeps and buy_state == 1 and buy_state[1] == 0, title="SMC: Buy Sweep", style=shape.circle, location=location.belowbar, color=color.blue, size=size.small, text="Sweep 💧")
plotshape(showReclaims and buy_state == 2 and buy_state[1] == 1, title="SMC: Buy Reclaim", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small, text="Reclaim ✓")
plotshape(showMSS and buy_state == 3 and buy_state[1] == 2, title="SMC: Buy MSS", style=shape.star, location=location.belowbar, color=color.green, size=size.normal, text="MSS ★")

plotshape(showSweeps and sell_state == 1 and sell_state[1] == 0, title="SMC: Sell Sweep", style=shape.circle, location=location.abovebar, color=color.orange, size=size.small, text="Sweep 💧")
plotshape(showReclaims and sell_state == 2 and sell_state[1] == 1, title="SMC: Sell Reclaim", style=shape.triangledown, location=location.abovebar, color=color.maroon, size=size.small, text="Reclaim ✓")
plotshape(showMSS and sell_state == 3 and sell_state[1] == 2, title="SMC: Sell MSS", style=shape.star, location=location.abovebar, color=color.red, size=size.normal, text="MSS ★")

// Active Trade Targets Plotting
plot(showSLTP and strategy.position_size != 0 ? active_sl : na, title="SMC: Stop Loss", color=color.red, style=plot.style_linebr, linewidth=1)
plot(showSLTP and strategy.position_size != 0 ? active_tp : na, title="SMC: Take Profit", color=color.green, style=plot.style_linebr, linewidth=1)


// --- 8. DYNAMIC STRATEGY ALERTS ---
if barstate.isconfirmed
    if buy_state == 1 and buy_state[1] == 0
        alert(syminfo.ticker + " BUY-Sweep: price wick below " + str.tostring(buy_sweep_low) + ", potential reversal")
    if buy_state == 2 and buy_state[1] == 1
        alert(syminfo.ticker + " BUY-Reclaim: price closed above " + str.tostring(buy_sweep_low) + " at " + str.tostring(close))
    if buy_state == 3 and buy_state[1] == 2
        alert(syminfo.ticker + " MSS Bullish: closed above LH")
    if buy_entry_signal_filtered
        alert(syminfo.ticker + " BUY Signal complete: entry=" + str.tostring(close) + ", SL=" + str.tostring(sl_long_calc) + ", TP=" + str.tostring(tp_long_calc))

    if sell_state == 1 and sell_state[1] == 0
        alert(syminfo.ticker + " SELL-Sweep: price wick above " + str.tostring(sell_sweep_high) + ", potential reversal")
    if sell_state == 2 and sell_state[1] == 1
        alert(syminfo.ticker + " SELL-Reclaim: price closed below " + str.tostring(sell_sweep_high) + " at " + str.tostring(close))
    if sell_state == 3 and sell_state[1] == 2
        alert(syminfo.ticker + " MSS Bearish: closed below HL")
    if sell_entry_signal_filtered
        alert(syminfo.ticker + " SELL Signal complete: entry=" + str.tostring(close) + ", SL=" + str.tostring(sl_short_calc) + ", TP=" + str.tostring(tp_short_calc))
