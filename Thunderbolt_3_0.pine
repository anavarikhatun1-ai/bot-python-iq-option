EMA50_out = ta.ema(EMA50_src, EMA50_Len)
plot(showEMA50 ? EMA50_out : na, title='EMA50', color=color.new(color.red, 0))

EMA100_Len = input.int(100, minval=1, title='EMA100_Length', group='EMA Lines')
EMA100_src = input.source(close, title='EMA100_Source', group='EMA Lines')
EMA100_out = ta.ema(EMA100_src, EMA100_Len)
plot(showEMA100 ? EMA100_out : na, title='EMA100', color=color.new(color.purple, 0))

EMA200_Len = input.int(200, minval=1, title='EMA200_Length', group='EMA Lines')
EMA200_src = input.source(close, title='EMA200_Source', group='EMA Lines')
EMA200_out = ta.ema(EMA200_src, EMA200_Len)
plot(showEMA200 ? EMA200_out : na, title='EMA200', color=color.new(color.green, 0))

// ==========================================
// SMA LINES
// ==========================================
SMA9_Len = input.int(9, minval=1, title='SMA9_Length', group='SMA Lines')
SMA9_out = ta.sma(close, SMA9_Len)
plot(showSMA9 ? SMA9_out : na, title='SMA9', color=color.new(color.green, 0))

SMA20_Len = input.int(20, minval=1, title='SMA20_Length', group='SMA Lines')
SMA20_out = ta.sma(close, SMA20_Len)
plot(showSMA20 ? SMA20_out : na, title='SMA20', color=color.new(color.red, 0))

SMA50_Len = input.int(50, minval=1, title='SMA50_Length', group='SMA Lines')
SMA50_out = ta.sma(close, SMA50_Len)
plot(showSMA50 ? SMA50_out : na, title='SMA50', color=color.new(color.olive, 0))

SMA100_Len = input.int(100, minval=1, title='SMA100_Length', group='SMA Lines')
SMA100_out = ta.sma(close, SMA100_Len)
plot(showSMA100 ? SMA100_out : na, title='SMA100', color=color.new(color.maroon, 0))

// ==========================================
// WMA LINES
// ==========================================
wMA9_Len = input.int(9, minval=1, title='wMA9_Length', group='WMA Lines')
wMA9_out = ta.wma(close, wMA9_Len)
plot(showwMA9 ? wMA9_out : na, title='wMA9', color=color.new(color.navy, 0))

wMA20_Len = input.int(20, minval=1, title='wMA20_Length', group='WMA Lines')
wMA20_out = ta.wma(close, wMA20_Len)
plot(showwMA20 ? wMA20_out : na, title='wMA20', color=color.new(color.olive, 0))

wMA50_Len = input.int(50, minval=1, title='wMA50_Length', group='WMA Lines')
wMA50_out = ta.wma(close, wMA50_Len)
plot(showwMA50 ? wMA50_out : na, title='wMA50', color=color.new(color.purple, 0))

wMA100_Len = input.int(100, minval=1, title='wMA100_Length', group='WMA Lines')
wMA100_out = ta.wma(close, wMA100_Len)
plot(showwMA100 ? wMA100_out : na, title='wMA100', color=color.new(color.gray, 0))

// ==========================================
// VWAP
// ==========================================
cvwap1 = ta.vwap(hlc3)
plot(showVWAP ? cvwap1 : na, title='VWAP', color=color.new(color.black, 0), linewidth=2)

// ==========================================
// VWMA LINES
// ==========================================
VWMAlen9 = input.int(9, "Length", minval=1, group='VWMA Lines')
srcVWMA9 = input.source(close, title='VWMA9_Source', group='VWMA Lines')
vwma9 = ta.vwma(srcVWMA9, VWMAlen9)
offset = 0
plot(showVWMA9 ? vwma9 : na, title='VWMA9', offset=offset, color=color.new(color.yellow, 0))

VWMAlen20 = input.int(20, "Length", minval=1, group='VWMA Lines')
srcVWMA20 = input.source(close, title='VWMA20_Source', group='VWMA Lines')
vwma20 = ta.vwma(srcVWMA20, VWMAlen20)
plot(showVWMA20 ? vwma20 : na, title='VWMA20', offset=offset, color=color.new(color.orange, 0))

VWMAlen50 = input.int(50, "Length", minval=1, group='VWMA Lines')
srcVWMA50 = input.source(close, title='VWMA50_Source', group='VWMA Lines')
vwma50 = ta.vwma(srcVWMA50, VWMAlen50)
plot(showVWMA50 ? vwma50 : na, title='VWMA50', offset=offset, color=color.new(color.green, 0))

// ==========================================
// PARABOLIC SAR
// ==========================================
start1 = input.float(0.02, "Start", minval=0.001, group='PSAR')
increment = input.float(0.02, "Increament", minval=0.001, group='PSAR')
maximum = 0.2
psar_out = ta.sar(start1, increment, maximum)
plot(showPSAR ? psar_out : na, 'ParabolicSAR', style=plot.style_cross, color=color.new(#2196f3, 0))

start2 = input.float(0.01, "Start", minval=0.001, group='PSAR2')
increment2 = input.float(0.01, "Increament", minval=0.001, group='PSAR2')
maximum2 = 0.1
psar_out2 = ta.sar(start2, increment2, maximum2)
plot(showPSAR2 ? psar_out2 : na, 'ParabolicSAR2', style=plot.style_cross, color=color.new(#8c0707, 0))

// ==========================================
// TRENDLINES & BREAKS (PRIMARY & SECONDARY)
// ==========================================
ShowTrendCandles = input.bool(false, title='Trend Candles', group='TREND')
ShowSupResZones  = input.bool(false, title='Support / Resistance Zones', group='TREND')
InvertColors     = input.bool(true, title='Support / Resistance Zones - Invert Colors', group='TREND')

a_Color_Type = input.string(title='1 - Primary - Trendlines - Color Scheme', defval='Colored', options=['Colored', 'Monochrome'], group='TREND')
a_Show_Primary = input.bool(true, title='1 - Primary - Trendlines', group='TREND')
a_Rising_Upper_Falling_Lower = input.bool(false, '1 - Primary - Rising Upper and Falling Lower Trendlines', group='TREND')
a_len = input.int(20, title='1 - Primary - Lookback Length', group='TREND')
a_Wicks = input.string(title='1 - Primary - Draw lines from', defval='Wicks', options=['Wicks', 'Real Bodies'], group='TREND')
a_Extensions = input.string(title='1 - Primary - Trendline Extensions', defval=' 150', options=['Infinate', '  25', '  50', '  75', ' 100', ' 150', ' 200', ' 300', ' 400', ' 500', ' 750', '1000'], group='TREND')
a_width = input.int(1, title='1 - Primary - Line Width', minval=0, maxval=10, group='TREND')
a_Line_Type_In = input.string(title='1 - Primary - Line Type', defval='Dashed', options=['Dashed', 'Dotted', 'Solid'], group='TREND')
a_Line_Type = a_Line_Type_In == 'Dashed' ? line.style_dashed : a_Line_Type_In == 'Dotted' ? line.style_dotted : line.style_solid

a_Show_Breaks = input.string(title='1 - Primary - Trendline Breaks;', defval='n/a', options=['Barcolor', 'Triangles + Barcolor', 'Triangles', 'n/a'], group='TREND')
a_trendline_nr = input.int(3, title='1 - Primary - Trendline Breaks - Number of Past Trendlines to Check for Breaks', minval=0, maxval=10, group='TREND')
a_select_breaks = input.bool(true, title='1 - Primary - Trendline Breaks - Display Only Long Breaks on Highs & Short for Lows', group='TREND')

b_Show_Secondary = input.bool(true, title='2 - Secondary - Trendlines', group='TREND SECONDARY')
b_Rising_Upper_Falling_Lower = input.bool(false, '2 - Secondary - Rising Upper and Falling Lower Trendlines', group='TREND SECONDARY')
b_len = input.int(7, title='2 - Secondary - Lookback Length', group='TREND SECONDARY')
b_Wicks = input.string(title='2 - Secondary - Draw lines from', defval='Wicks', options=['Wicks', 'Real Bodies'], group='TREND SECONDARY')
b_Extensions = input.string(title='2 - Secondary - Trendline Extensions', defval='  25', options=['Infinate', '  25', '  50', '  75', ' 100', ' 150', ' 200', ' 300', ' 400', ' 500', ' 750', '1000'], group='TREND SECONDARY')
b_width = input.int(1, title='2 - Secondary - Line Width', minval=0, maxval=10, group='TREND SECONDARY')
b_Line_Type_In = input.string(title='2 - Secondary - Line Type', defval='Dotted', options=['Dashed', 'Dotted', 'Solid'], group='TREND SECONDARY')
b_Line_Type = b_Line_Type_In == 'Dashed' ? line.style_dashed : b_Line_Type_In == 'Dotted' ? line.style_dotted : line.style_solid

b_Show_Breaks = input.string(title='2 - Secondary - Trendline Breaks;', defval='n/a', options=['Barcolor', 'Triangles + Barcolor', 'Triangles', 'n/a'], group='TREND SECONDARY')
b_trendline_nr = input.int(5, title='2 - Secondary - Trendline Breaks - Number of Past Trendlines to Check for Breaks', minval=0, maxval=10, group='TREND SECONDARY')
b_select_breaks = input.bool(true, title='2 - Secondary - Trendline Breaks - Display Only Long Breaks on Highs & Short for Lows', group='TREND SECONDARY')

log_chart = input.bool(false, title='Log Chart?', group='TREND')

a_bar_time = time - time[1]
b_bar_time = time - time[1]

a_Extension_Multiplier = a_Extensions == '  25' ? 1 : a_Extensions == '  50' ? 2 : a_Extensions == '  75' ? 3 : a_Extensions == ' 100' ? 4 : a_Extensions == ' 150' ? 6 : a_Extensions == ' 200' ? 8 : a_Extensions == ' 300' ? 12 : a_Extensions == ' 400' ? 16 : a_Extensions == ' 500' ? 20 : a_Extensions == ' 750' ? 30 : a_Extensions == '1000' ? 40 : a_Extensions == 'Infinate' ? 0 : na

a_f_trendline(a__input_function, a__delay, a__only_up, a__extend) =>
    var int a_Ax = 1
    var int a_Bx = 1
    var float a_By = 0.0
    var float a_slope = 0.0
    a_Ay = fixnan(a__input_function)
    if ta.change(a_Ay) != 0
        a_Ax := time[a__delay]
        a_By := a_Ay[1]
        a_Bx := a_Ax[1]
        a_slope := log_chart ? (math.log(a_Ay) - math.log(a_By)) / (a_Ax - a_Bx) : (a_Ay - a_By) / (a_Ax - a_Bx)
        a_slope
    else
        a_Ax := a_Ax[1]
        a_Bx := a_Bx[1]
        a_By := a_By[1]
        a_By
    var line a_trendline = na
    var int a_Axbis = 0
    var float a_Aybis = 0.0
    var bool a__xtend = true
    a_extension_time = a_Extension_Multiplier * a_bar_time * 25
    a_Axbis := a_Ax + a_extension_time
    a_Aybis := log_chart ? a_Ay * math.exp(a_extension_time * a_slope) : a_Ay + a_extension_time * a_slope
    if a_Extension_Multiplier != 0
        a__xtend := false
        a__xtend
    if ta.change(a_Ay) != 0
        a_line_color_Rising_Falling = a_slope * time < 0 ? a__only_up ? a_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na : a_Color_Type == 'Colored' ? color.green : color.teal : a__only_up ? a_Color_Type == 'Colored' ? color.red : color.teal : a_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na
        a_line_color_Not_Rising_Falling = a_slope * time < 0 ? a__only_up ? na : a_Color_Type == 'Colored' ? color.green : color.teal : a__only_up ? a_Color_Type == 'Colored' ? color.red : color.teal : na
        a_line_color = a_Show_Primary and not a_Rising_Upper_Falling_Lower ? a_line_color_Not_Rising_Falling : a_Show_Primary and a_Rising_Upper_Falling_Lower ? a_line_color_Rising_Falling : na

        if not na(a_line_color)
            a_trendline := line.new(a_Bx, a_By, a_Axbis, a_Aybis, xloc.bar_time, extend=a__xtend ? extend.right : extend.none, color=a_line_color, style=a_Line_Type, width=a_width)
            a_trendline
    [a_Bx, a_By, a_Axbis, a_Aybis, a_slope]

a_line_get_price(a__start_time, a__start_price, a__slope, a__lookback_period, a__log_chart) =>
    var float a_current_price = 0.0
    a_elapsed_time = time - a__start_time
    a_current_price := a__log_chart ? a__start_price * math.exp((a_elapsed_time - a__lookback_period * a_bar_time) * a__slope) : a__start_price + (a_elapsed_time - a__lookback_period * a_bar_time) * a__slope
    a_current_price

a_line_cross(a__check_value, a__start_time, a__start_price, a__slope, a__log_chart) =>
    var float a_current_value = 0.0
    var float a_previous_value = 0.0
    a_current_value := a_line_get_price(a__start_time, a__start_price, a__slope, 0, a__log_chart)
    a_previous_value := a_line_get_price(a__start_time, a__start_price, a__slope, 1, a__log_chart)
    a_cross = a__check_value[1] < a_previous_value and a__check_value > a_current_value ? 1 : a__check_value[1] > a_previous_value and a__check_value < a_current_value ? -1 : 0
    a_cross

// Correct integer division for Pine v5
int a_delay_int = int(a_len / 2)
a_high_point = ta.pivothigh(a_Wicks == 'Wicks' ? high : close > open ? close : open, a_len, a_delay_int)
a_low_point = ta.pivotlow(a_Wicks == 'Wicks' ? low : close > open ? open : close, a_len, a_delay_int)

[a_phx1, a_phy1, a_phx2, a_phy2, a_slope_high] = a_f_trendline(a_high_point, a_delay_int, false, true)
[a_plx1, a_ply1, a_plx2, a_ply2, a_slope_low] = a_f_trendline(a_low_point, a_delay_int, true, true)

var int a_high_x0 = 0, var float a_high_y0 = 0.0, var float a_high_sl0 = 0.0
var int a_high_x1 = 0, var float a_high_y1 = 0.0, var float a_high_sl1 = 0.0
var int a_high_x2 = 0, var float a_high_y2 = 0.0, var float a_high_sl2 = 0.0
var int a_high_x3 = 0, var float a_high_y3 = 0.0, var float a_high_sl3 = 0.0
var int a_high_x4 = 0, var float a_high_y4 = 0.0, var float a_high_sl4 = 0.0
var int a_high_x5 = 0, var float a_high_y5 = 0.0, var float a_high_sl5 = 0.0
var int a_high_x6 = 0, var float a_high_y6 = 0.0, var float a_high_sl6 = 0.0
var int a_high_x7 = 0, var float a_high_y7 = 0.0, var float a_high_sl7 = 0.0
var int a_high_x8 = 0, var float a_high_y8 = 0.0, var float a_high_sl8 = 0.0
var int a_high_x9 = 0, var float a_high_y9 = 0.0, var float a_high_sl9 = 0.0

var int a_low_x0 = 0, var float a_low_y0 = 0.0, var float a_low_sl0 = 0.0
var int a_low_x1 = 0, var float a_low_y1 = 0.0, var float a_low_sl1 = 0.0
var int a_low_x2 = 0, var float a_low_y2 = 0.0, var float a_low_sl2 = 0.0
var int a_low_x3 = 0, var float a_low_y3 = 0.0, var float a_low_sl3 = 0.0
var int a_low_x4 = 0, var float a_low_y4 = 0.0, var float a_low_sl4 = 0.0
var int a_low_x5 = 0, var float a_low_y5 = 0.0, var float a_low_sl5 = 0.0
var int a_low_x6 = 0, var float a_low_y6 = 0.0, var float a_low_sl6 = 0.0
var int a_low_x7 = 0, var float a_low_y7 = 0.0, var float a_low_sl7 = 0.0
var int a_low_x8 = 0, var float a_low_y8 = 0.0, var float a_low_sl8 = 0.0
var int a_low_x9 = 0, var float a_low_y9 = 0.0, var float a_low_sl9 = 0.0

if ta.change(fixnan(a_high_point)) != 0
    a_high_x9 := a_high_x8, a_high_y9 := a_high_y8, a_high_sl9 := a_high_sl8
    a_high_x8 := a_high_x7, a_high_y8 := a_high_y7, a_high_sl8 := a_high_sl7
    a_high_x7 := a_high_x6, a_high_y7 := a_high_y6, a_high_sl7 := a_high_sl6
    a_high_x6 := a_high_x5, a_high_y6 := a_high_y5, a_high_sl6 := a_high_sl5
    a_high_x5 := a_high_x4, a_high_y5 := a_high_y4, a_high_sl5 := a_high_sl4
    a_high_x4 := a_high_x3, a_high_y4 := a_high_y3, a_high_sl4 := a_high_sl3
    a_high_x3 := a_high_x2, a_high_y3 := a_high_y2, a_high_sl3 := a_high_sl2
    a_high_x2 := a_high_x1, a_high_y2 := a_high_y1, a_high_sl2 := a_high_sl1
    a_high_x1 := a_high_x0, a_high_y1 := a_high_y0, a_high_sl1 := a_high_sl0
    a_high_x0 := a_phx1, a_high_y0 := a_phy1, a_high_sl0 := a_slope_high

if ta.change(fixnan(a_low_point)) != 0
    a_low_x9 := a_low_x8, a_low_y9 := a_low_y8, a_low_sl9 := a_low_sl8
    a_low_x8 := a_low_x7, a_low_y8 := a_low_y7, a_low_sl8 := a_low_sl7
    a_low_x7 := a_low_x6, a_low_y7 := a_low_y6, a_low_sl7 := a_low_sl6
    a_low_x6 := a_low_x5, a_low_y6 := a_low_y5, a_low_sl6 := a_low_sl5
    a_low_x5 := a_low_x4, a_low_y5 := a_low_y4, a_low_sl5 := a_low_sl4
    a_low_x4 := a_low_x3, a_low_y4 := a_low_y3, a_low_sl4 := a_low_sl3
    a_low_x3 := a_low_x2, a_low_y3 := a_low_y2, a_low_sl3 := a_low_sl2
    a_low_x2 := a_low_x1, a_low_y2 := a_low_y1, a_low_sl2 := a_low_sl1
    a_low_x1 := a_low_x0, a_low_y1 := a_low_y0, a_low_sl1 := a_low_sl0
    a_low_x0 := a_plx1, a_low_y0 := a_ply1, a_low_sl0 := a_slope_low

a_cross_high0 = not a_Rising_Upper_Falling_Lower and a_high_sl0 * time > 0 ? 0 : a_line_cross(close, a_high_x0, a_high_y0, a_high_sl0, log_chart)
a_cross_low0 = not a_Rising_Upper_Falling_Lower and a_low_sl0 * time < 0 ? 0 : a_line_cross(close, a_low_x0, a_low_y0, a_low_sl0, log_chart)
a_cross_high1 = not a_Rising_Upper_Falling_Lower and a_high_sl1 * time > 0 ? 0 : a_line_cross(close, a_high_x1, a_high_y1, a_high_sl1, log_chart)
a_cross_low1 = not a_Rising_Upper_Falling_Lower and a_low_sl1 * time < 0 ? 0 : a_line_cross(close, a_low_x1, a_low_y1, a_low_sl1, log_chart)
a_cross_high2 = not a_Rising_Upper_Falling_Lower and a_high_sl2 * time > 0 ? 0 : a_line_cross(close, a_high_x2, a_high_y2, a_high_sl2, log_chart)
