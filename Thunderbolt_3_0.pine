//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////// PARABOLIC SAR //////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
start1 = input.float(0.02,"Start",minval=0.001, group = 'PSAR')
increment = input.float(0.02,"Increament",minval=0.001, group = 'PSAR')
maximum = 0.2
psar_out = ta.sar(start1, increment, maximum)
plot(showPSAR ? psar_out : na, 'ParabolicSAR', style=plot.style_cross, color=color.new(#2196f3, 0))

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////// PARABOLIC SAR2 //////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
start2 = input.float(0.01,"Start",minval=0.001, group = 'PSAR2')
increment2 = input.float(0.01,"Increament",minval=0.001, group = 'PSAR2')
maximum2 = 0.1
psar_out2 = ta.sar(start2, increment2, maximum2)
plot(showPSAR2 ? psar_out2 : na, 'ParabolicSAR2', style=plot.style_cross, color=color.new(#8c0707, 0))


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// Input variables

ShowTrendCandles = input.bool(false, title='Trend Candles', group = 'TREND')

ShowSupResZones = input.bool(false, title='Support / Resistance Zones', group = 'TREND')

InvertColors = input.bool(true, title='Support / Resistance Zones - Invert Colors', group = 'TREND')


a_Color_Type = input.string(title='---------------------Trendlines - 1 & 2 - Color Scheme-------------', defval='Colored', options=['Colored', 'Monochrome'], group = 'TREND')


a_Show_Primary = input.bool(true, title='1 - Primary - Trendlines ---------------------------------------------------------------', group = 'TREND')

a_Rising_Upper_Falling_Lower = input.bool(false, '1 - Primary - Rising Upper and Falling Lower Trendlines', group = 'TREND')


a_len = input.int(20, title='1 - Primary - Lookback Length', group = 'TREND')

a_Wicks = input.string(title='1 - Primary - Draw lines from', defval='Wicks', options=['Wicks', 'Real Bodies'], group = 'TREND')

a_Extensions = input.string(title='1 - Primary - Trendline Extensions', defval=' 150', options=['Infinate', '  25', '  50', '  75', ' 100', ' 150', ' 200', ' 300', ' 400', ' 500', ' 750', '1000'])

a_width = input.int(1, title='1 - Primary - Line Width', minval=0, maxval=10)


a_Line_Type_In = input.string(title='1 - Primary - Line Type', defval='Dashed', options=['Dashed', 'Dotted', 'Solid'])

a_Line_Type = a_Line_Type_In == 'Dashed' ? line.style_dashed : a_Line_Type_In == 'Dotted' ? line.style_dotted : line.style_solid


a_Show_Breaks = input.string(title='1 - Primary - Trendline Breaks;', defval='n/a', options=['Barcolor', 'Triangles + Barcolor', 'Triangles', 'n/a'])

a_trendline_nr = input.int(3, title='1 - Primary - Trendline Breaks - Number of Past Trendlines to Check for Breaks', minval=0, maxval=10)

a_select_breaks = input.bool(true, title='1 - Primary - Trendline Breaks - Display Only - \'Long\' Breaks on Trendlines Connecting \'Highs\' and \'Short\' for \'Lows\'')


b_Show_Secondary = input.bool(true, title='2 - Secondary - Trendlines ------------------------------------------------------------')

b_Rising_Upper_Falling_Lower = input.bool(false, '2 - Secondary - Rising Upper and Falling Lower Trendlines')


b_len = input.int(7, title='2 - Secondary - Lookback Length')

b_Wicks = input.string(title='2 - Secondary - Draw lines from', defval='Wicks', options=['Wicks', 'Real Bodies'])

b_Extensions = input.string(title='2 - Secondary - Trendline Extensions', defval='  25', options=['Infinate', '  25', '  50', '  75', ' 100', ' 150', ' 200', ' 300', ' 400', ' 500', ' 750', '1000'])

b_width = input.int(1, title='2 - Secondary - Line Width', minval=0, maxval=10)


b_Line_Type_In = input.string(title='2 - Secondary - Line Type', defval='Dotted', options=['Dashed', 'Dotted', 'Solid'])

b_Line_Type = b_Line_Type_In == 'Dashed' ? line.style_dashed : b_Line_Type_In == 'Dotted' ? line.style_dotted : line.style_solid


b_Show_Breaks = input.string(title='2 - Secondary - Trendline Breaks;', defval='n/a', options=['Barcolor', 'Triangles + Barcolor', 'Triangles', 'n/a'])

b_trendline_nr = input.int(5, title='2 - Secondary - Trendline Breaks - Number of Past Trendlines to Check for Breaks', minval=0, maxval=10)

b_select_breaks = input.bool(true, title='2 - Secondary - Trendline Breaks - Display Only - \'Long\' Breaks on Trendlines Connecting \'Highs\' and \'Short\' for \'Lows\'')


log_chart = input.bool(false, title='Log Chart?')

a_bar_time = time - time[1]

b_bar_time = time - time[1]


///// Primary Trendlines /////

// Trendline Extensions

a_Extension_Multiplier = a_Extensions == '  25' ? 1 : a_Extensions == '  50' ? 2 : a_Extensions == '  75' ? 3 : a_Extensions == ' 100' ? 4 : a_Extensions == ' 150' ? 6 : a_Extensions == ' 200' ? 8 : a_Extensions == ' 300' ? 12 : a_Extensions == ' 400' ? 16 : a_Extensions == ' 500' ? 20 : a_Extensions == ' 750' ? 30 : a_Extensions == '1000' ? 40 : a_Extensions == 'Infinate' ? 0 : na


// Declaration of trendline function



// Function to get trendline price for X bars ago ("0" = current value)
a_line_get_price(a__start_time, a__start_price, a__slope, a__lookback_period, a__log_chart) =>
    float a_current_price = 0.0
    a_elapsed_time = time - a__start_time
    a_current_price := a__log_chart ? a__start_price * math.exp((a_elapsed_time - a__lookback_period * a_bar_time) * a__slope) : a__start_price + (a_elapsed_time - a__lookback_period * a_bar_time) * a__slope
    a_current_price


// Function to check for trendline crosses
a_line_cross(a__check_value, a__start_time, a__start_price, a__slope, a__log_chart) =>
    float a_current_value = 0.0
    float a_previous_value = 0.0
    // Get current and previous price for the trendline
    a_current_value := a_line_get_price(a__start_time, a__start_price, a__slope, 0, a__log_chart)  // 0, a__log_chart)
    a_previous_value := a_line_get_price(a__start_time, a__start_price, a__slope, 1, a__log_chart)  //1, a__log_chart)
    // Return 1 for crossover, -1 for crossunder and 0 for no cross detected
    a_cross = a__check_value[1] < a_previous_value and a__check_value > a_current_value ? 1 : a__check_value[1] > a_previous_value and a__check_value < a_current_value ? -1 : 0
    a_cross


// Calculate pivot points
a_high_point = ta.pivothigh(a_Wicks == 'Wicks' ? high : close > open ? close : open, a_len, a_len / 2)
a_low_point = ta.pivotlow(a_Wicks == 'Wicks' ? low : close > open ? open : close, a_len, a_len / 2)

// --- SMC: Inlined Primary High Trendline Calculation ---
var int a_high_Ax = 1
var int a_high_Bx = 1
var float a_high_By = 0.0
var float a_high_slope = 0.0

a_high_Ay = fixnan(a_high_point)
if ta.change(a_high_Ay) != 0
    int prev_Ax = a_high_Ax
    a_high_Ax := time[int(a_len / 2)]
    a_high_By := a_high_Ay[1]
    a_high_Bx := prev_Ax
    a_high_slope := log_chart ? (math.log(a_high_Ay) - math.log(a_high_By)) / (a_high_Ax - a_high_Bx) : (a_high_Ay - a_high_By) / (a_high_Ax - a_high_Bx)

var line a_high_trendline = na
var int a_high_Axbis = 0
var float a_high_Aybis = 0
var bool a_high_xtend = true
a_high_extension_time = a_Extension_Multiplier * a_bar_time * 25
a_high_Axbis := a_high_Ax + a_high_extension_time
a_high_Aybis := log_chart ? a_high_Ay * math.exp(a_high_extension_time * a_high_slope) : a_high_Ay + a_high_extension_time * a_high_slope
if a_Extension_Multiplier != 0
    a_high_xtend := false

if ta.change(a_high_Ay) != 0
    a_line_color_Rising_Falling = a_high_slope * time < 0 ? false ? a_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na : a_Color_Type == 'Colored' ? color.green : color.teal : false ? a_Color_Type == 'Colored' ? color.red : color.teal : a_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na
    a_line_color_Not_Rising_Falling = a_high_slope * time < 0 ? false ? na : a_Color_Type == 'Colored' ? color.green : color.teal : false ? a_Color_Type == 'Colored' ? color.red : color.teal : na
    a_line_color = a_Show_Primary and not a_Rising_Upper_Falling_Lower ? a_line_color_Not_Rising_Falling : a_Show_Primary and a_Rising_Upper_Falling_Lower ? a_line_color_Rising_Falling : na
    if not na(a_line_color)
        a_high_trendline := line.new(a_high_Bx, a_high_By, a_high_Axbis, a_high_Aybis, xloc.bar_time, extend=a_high_xtend ? extend.right : extend.none, color=a_line_color, style=a_Line_Type, width=a_width)

a_phx1 = a_high_Bx
a_phy1 = a_high_By
a_phx2 = a_high_Axbis
a_phy2 = a_high_Aybis
a_slope_high = a_high_slope


// --- SMC: Inlined Primary Low Trendline Calculation ---
var int a_low_Ax = 1
var int a_low_Bx = 1
var float a_low_By = 0.0
var float a_low_slope = 0.0

a_low_Ay = fixnan(a_low_point)
if ta.change(a_low_Ay) != 0
    int prev_Ax = a_low_Ax
    a_low_Ax := time[int(a_len / 2)]
    a_low_By := a_low_Ay[1]
    a_low_Bx := prev_Ax
    a_low_slope := log_chart ? (math.log(a_low_Ay) - math.log(a_low_By)) / (a_low_Ax - a_low_Bx) : (a_low_Ay - a_low_By) / (a_low_Ax - a_low_Bx)

var line a_low_trendline = na
var int a_low_Axbis = 0
var float a_low_Aybis = 0
var bool a_low_xtend = true
a_low_extension_time = a_Extension_Multiplier * a_bar_time * 25
a_low_Axbis := a_low_Ax + a_low_extension_time
a_low_Aybis := log_chart ? a_low_Ay * math.exp(a_low_extension_time * a_low_slope) : a_low_Ay + a_low_extension_time * a_low_slope
if a_Extension_Multiplier != 0
    a_low_xtend := false

if ta.change(a_low_Ay) != 0
    a_line_color_Rising_Falling = a_low_slope * time < 0 ? true ? a_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na : a_Color_Type == 'Colored' ? color.green : color.teal : true ? a_Color_Type == 'Colored' ? color.red : color.teal : a_Rising_Upper_Falling_Lower ? a_Color_Type == 'Colored' ? color.gray : color.teal : na
    a_line_color_Not_Rising_Falling = a_low_slope * time < 0 ? true ? na : a_Color_Type == 'Colored' ? color.green : color.teal : true ? a_Color_Type == 'Colored' ? color.red : color.teal : na
    a_line_color = a_Show_Primary and not a_Rising_Upper_Falling_Lower ? a_line_color_Not_Rising_Falling : a_Show_Primary and a_Rising_Upper_Falling_Lower ? a_line_color_Rising_Falling : na
    if not na(a_line_color)
        a_low_trendline := line.new(a_low_Bx, a_low_By, a_low_Axbis, a_low_Aybis, xloc.bar_time, extend=a_low_xtend ? extend.right : extend.none, color=a_line_color, style=a_Line_Type, width=a_width)

a_plx1 = a_low_Bx
a_ply1 = a_low_By
a_plx2 = a_low_Axbis
a_ply2 = a_low_Aybis
a_slope_low = a_low_slope


// Initialition of pseudo array to keep track of last 10 high and 10 low trendline values
var int a_high_x0 = 0
var float a_high_y0 = 0.0
var float a_high_sl0 = 0.0
var int a_high_x1 = 0
var float a_high_y1 = 0.0
var float a_high_sl1 = 0.0
var int a_high_x2 = 0
var float a_high_y2 = 0.0
var float a_high_sl2 = 0.0
var int a_high_x3 = 0
var float a_high_y3 = 0.0
var float a_high_sl3 = 0.0
var int a_high_x4 = 0
var float a_high_y4 = 0.0
var float a_high_sl4 = 0.0
var int a_high_x5 = 0
var float a_high_y5 = 0.0
var float a_high_sl5 = 0.0
var int a_high_x6 = 0
var float a_high_y6 = 0.0
var float a_high_sl6 = 0.0
var int a_high_x7 = 0
var float a_high_y7 = 0.0
var float a_high_sl7 = 0.0
var int a_high_x8 = 0
var float a_high_y8 = 0.0
var float a_high_sl8 = 0.0
var int a_high_x9 = 0
var float a_high_y9 = 0.0
var float a_high_sl9 = 0.0

var int a_low_x0 = 0
var float a_low_y0 = 0.0
var float a_low_sl0 = 0.0
var int a_low_x1 = 0
var float a_low_y1 = 0.0
var float a_low_sl1 = 0.0
var int a_low_x2 = 0
var float a_low_y2 = 0.0
var float a_low_sl2 = 0.0
var int a_low_x3 = 0
