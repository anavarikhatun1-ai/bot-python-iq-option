// User inputs
showTomorrowCPR = input.bool(title='Show tomorrow\'s CPR', defval=true, group = 'CPR')
showHistoricalCPR = input.bool(true, title='Show historical CPR', defval=false, group = 'CPR')
showR3S3 = input.bool(title='Show R3 & S3', defval=false, group = 'CPR')


// Defaults
// CPR Colors
cprColor = color.yellow
rColor = color.fuchsia
sColor = color.aqua

// Line style & Transparency
lStyle = plot.style_line
lTransp = 35

//Fill Transparency
fTransp = 95


// Global Variables & Flags
// TODO : Update the No of Holidays
noOfHolidays = 12


// Global Functions
// TODO : Update the list of Holiday here in format YYYY, MM, DD, 09, 15
// **09, 15 are session start hour & minutes
IsHoliday(_date) =>
    iff_1 = _date == timestamp(2020, 12, 25, 9, 15) ? true : false
    iff_2 = _date == timestamp(2020, 11, 30, 9, 15) ? true : iff_1
    iff_3 = _date == timestamp(2020, 11, 16, 9, 15) ? true : iff_2
    iff_4 = _date == timestamp(2020, 10, 2, 9, 15) ? true : iff_3
    iff_5 = _date == timestamp(2020, 5, 25, 9, 15) ? true : iff_4
    iff_6 = _date == timestamp(2020, 5, 1, 9, 15) ? true : iff_5
    iff_7 = _date == timestamp(2020, 4, 14, 9, 15) ? true : iff_6
    iff_8 = _date == timestamp(2020, 4, 10, 9, 15) ? true : iff_7
    iff_9 = _date == timestamp(2020, 4, 6, 9, 15) ? true : iff_8
    iff_10 = _date == timestamp(2020, 4, 2, 9, 15) ? true : iff_9
    iff_11 = _date == timestamp(2020, 3, 10, 9, 15) ? true : iff_10
    _date == timestamp(2020, 2, 21, 9, 15) ? true : iff_11

// Note: Week of Sunday=1...Saturday=7
IsWeekend(_date) =>
    dayofweek(_date) == 7 or dayofweek(_date) == 1

// Skip Weekend
SkipWeekend(_date) =>
    _d = dayofweek(_date)
    _mul = _d == 6 ? 3 : _d == 7 ? 2 : 1

    _date + _mul * 86400000


// Get Next Working Day
GetNextWorkingDay(_date) =>
    _dt = SkipWeekend(_date)

    for i = 1 to noOfHolidays by 1
        if IsHoliday(_dt)
            _dt := SkipWeekend(_dt)
            continue
        else
            break

    _dt


// Today's Session Start timestamp

// --- SMC: CPR Lines/Labels Global Persistent Variables ---
var line _r3 = na
