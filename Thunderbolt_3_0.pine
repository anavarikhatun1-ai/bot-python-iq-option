// ==========================================
// TREND CANDLES
// ==========================================
haclose = ohlc4
haopen = 0.0
haopen := na(haopen[1]) ? (open + close) / 2 : (haopen[1] + haclose[1]) / 2
ccolor = haclose - haopen > 0 ? 1 : 0

inside1 = haopen <= math.max(haopen[1], haclose[1]) and haopen >= math.min(haopen[1], haclose[1]) and haclose <= math.max(haopen[1], haclose[1]) and haclose >= math.min(haopen[1], haclose[1]) ? 1 : 0
colorvalue = inside1 ? ccolor[1] : ccolor
Trend_Candle_Color = colorvalue ? color.lime : color.red
barcolor(ShowTrendCandles ? Trend_Candle_Color : na, title='Trend Candles')

// ==========================================
// SUPPORT / RESISTANCE ZONES
// ==========================================
TF1 = timeframe.period
TF1_Vol = request.security(syminfo.tickerid, TF1, volume)
TF1_VolMA = ta.sma(TF1_Vol, 6)
TF1_High = request.security(syminfo.tickerid, TF1, high)
TF1_Low = request.security(syminfo.tickerid, TF1, low)
TF1_Open = request.security(syminfo.tickerid, TF1, open)
TF1_Close = request.security(syminfo.tickerid, TF1, close)

TF1_Up = TF1_High[3] > TF1_High[4] and TF1_High[4] > TF1_High[5] and TF1_High[2] < TF1_High[3] and TF1_High[1] < TF1_High[2] and TF1_Vol[3] > TF1_VolMA[3]
TF1_Down = TF1_Low[3] < TF1_Low[4] and TF1_Low[4] < TF1_Low[5] and TF1_Low[2] > TF1_Low[3] and TF1_Low[1] > TF1_Low[2] and TF1_Vol[3] > TF1_VolMA[3]

TF1_CalcFractalUp() =>
    TF1_FractalUp = 0.0
    TF1_FractalUp := TF1_Up ? TF1_High[3] : TF1_FractalUp[1]
    TF1_FractalUp

TF1_CalcFractalDown() =>
    TF1_FractalDown = 0.0
    TF1_FractalDown := TF1_Down ? TF1_Low[3] : TF1_FractalDown[1]
    TF1_FractalDown

TF1_FractalUp = request.security(syminfo.tickerid, TF1, TF1_CalcFractalUp())
TF1_FractalDown = request.security(syminfo.tickerid, TF1, TF1_CalcFractalDown())

TF1_CalcFractalUpLowerZone() =>
    TF1_FractalUpLowerZone = 0.0
    TF1_FractalUpLowerZone := TF1_Up and TF1_Close[3] > TF1_Open[3] ? TF1_Close[3] : TF1_Up and TF1_Close[3] < TF1_Open[3] ? TF1_Open[3] : TF1_FractalUpLowerZone[1]
    TF1_FractalUpLowerZone

TF1_CalcFractalUpUpperZone() =>
    TF1_FractalUpUpperZone = 0.0
    TF1_FractalUpUpperZone := TF1_Up and TF1_Close[3] > TF1_Open[3] ? TF1_High[3] - TF1_Close[3] + TF1_High[3] : TF1_Up and TF1_Close[3] < TF1_Open[3] ? TF1_High[3] - TF1_Open[3] + TF1_High[3] : TF1_FractalUpUpperZone[1]
    TF1_FractalUpUpperZone

TF1_FractalUpLowerZone = request.security(syminfo.tickerid, TF1, TF1_CalcFractalUpLowerZone())
TF1_FractalUpUpperZone = request.security(syminfo.tickerid, TF1, TF1_CalcFractalUpUpperZone())

TF1_CalcFractalDownUpperZone() =>
    TF1_FractalDownUpperZone = 0.0
    TF1_FractalDownUpperZone := TF1_Down and TF1_Close[3] > TF1_Open[3] ? TF1_Open[3] : TF1_Down and TF1_Close[3] < TF1_Open[3] ? TF1_Close[3] : TF1_FractalDownUpperZone[1]
    TF1_FractalDownUpperZone

TF1_CalcFractalDownLowerZone() =>
    TF1_FractalDownLowerZone = 0.0
    TF1_FractalDownLowerZone := TF1_Down and TF1_Close[3] > TF1_Open[3] ? TF1_Low[3] + TF1_Low[3] - TF1_Open[3] : TF1_Down and TF1_Close[3] < TF1_Open[3] ? TF1_Low[3] + TF1_Low[3] - TF1_Close[3] : TF1_FractalDownLowerZone[1]
    TF1_FractalDownLowerZone

TF1_FractalDownLowerZone = request.security(syminfo.tickerid, TF1, TF1_CalcFractalDownLowerZone())
TF1_FractalDownUpperZone = request.security(syminfo.tickerid, TF1, TF1_CalcFractalDownUpperZone())

TF1_ResistanceColor = not InvertColors ? #FF00008C : #00FF00E6
TF1_SupportColor = not InvertColors ? #00FF00E6 : #FF00008C

TF1_ResZoneColor = TF1_FractalUp != TF1_FractalUp[1] ? na : color.red
TF1_ResZoneColorInverted = TF1_FractalUp != TF1_FractalUp[1] ? na : color.lime
TF1_SupZoneColor = TF1_FractalDown != TF1_FractalDown[1] ? na : color.lime
TF1_SupZoneColorInverted = TF1_FractalDown != TF1_FractalDown[1] ? na : color.red

TF1_ResistanceZonesColor = not InvertColors ? TF1_ResZoneColor : TF1_ResZoneColorInverted
TF1_SupportZonesColor = not InvertColors ? TF1_SupZoneColor : TF1_SupZoneColorInverted

TF1_ResistanceUpZone = plot(ShowSupResZones ? TF1_FractalUpUpperZone : na, 'Resistance Upper Zone', color=TF1_ResistanceZonesColor)
TF1_ResistanceDownZone = plot(ShowSupResZones ? TF1_FractalUpLowerZone : na, 'Resistance Lower Zone', color=TF1_ResistanceZonesColor)
fill(TF1_ResistanceUpZone, TF1_ResistanceDownZone, color=TF1_ResistanceZonesColor, title='Resistance Zone Shading')

TF1_SupportUpZone = plot(ShowSupResZones ? TF1_FractalDownUpperZone : na, 'Support Upper Zone', color=TF1_SupportZonesColor)
TF1_SupportDownZone = plot(ShowSupResZones ? TF1_FractalDownLowerZone : na, 'Support Lower Zone', color=TF1_SupportZonesColor)
fill(TF1_SupportUpZone, TF1_SupportDownZone, color=TF1_SupportZonesColor, title='Support Zone Shading')

// ==========================================
// CENTRAL PIVOT RANGE (CPR)
// ==========================================
showTomorrowCPR   = input.bool(title='Show tomorrow\'s CPR', defval=true, group='CPR')
showHistoricalCPR = input.bool(title='Show historical CPR', defval=false, group='CPR')
showR3S3          = input.bool(title='Show R3 & S3', defval=false, group='CPR')

cprColor = color.yellow
rColor   = color.fuchsia
sColor   = color.aqua

IsHoliday(_date) =>
    iff_1 = _date == timestamp(2020, 12, 25, 9, 15) ? true : false
    iff_2 = _date == timestamp(2020, 11, 30, 9, 15) ? true : iff_1
    iff_3 = _date == timestamp(2020, 11, 16, 9, 15) ? true : iff_2
    _date == timestamp(2020, 10, 2, 9, 15) ? true : iff_3

IsWeekend(_date) =>
    dayofweek(_date) == 7 or dayofweek(_date) == 1

SkipWeekend(_date) =>
    _d = dayofweek(_date)
    _mul = _d == 6 ? 3 : _d == 7 ? 2 : 1
    _date + _mul * 86400000

GetNextWorkingDay(_date) =>
    _dt = SkipWeekend(_date)
    for i = 1 to 12 by 1
        if IsHoliday(_dt)
            _dt := SkipWeekend(_dt)
            continue
        else
            break
    _dt

y = year(timenow)
m = month(timenow)
d = dayofmonth(timenow)

start = timestamp(y, m, d, 9, 15)
end = start + 86400000
shouldPlotToday = timenow > start

tom_start = start
tom_end = end

if shouldPlotToday
    tom_start := GetNextWorkingDay(start)
    tom_end := tom_start + 86400000

getSeries(e, timeFrame) =>
    request.security(syminfo.tickerid, 'D', e, lookahead=barmerge.lookahead_on)

H = getSeries(high[1], 'D')
L = getSeries(low[1], 'D')
C = getSeries(close[1], 'D')

P = (H + L + C) / 3
TC = (H + L) / 2
BC = P - TC + P

R3 = H + 2 * (P - L)
R2 = P + H - L
R1 = P * 2 - L
S1 = P * 2 - H
S2 = P - (H - L)
S3 = L - 2 * (H - P)

p_cprTC = plot(showHistoricalCPR ? TC : na, title=' CTC', color=cprColor)
p_cprBC = plot(showHistoricalCPR ? BC : na, title=' CBC', color=cprColor)
fill(p_cprTC, p_cprBC, color=color.purple, transp=95)

// ==========================================
// RSI PIVOTS & MARKET STRUCTURE TRACKING (HH, LH, HL, LL)
// ==========================================
rsiSource     = input.source(title='RSI Source', defval=close, group='Pivot Structure')
rsiLength     = input.int(title='RSI Length', defval=7, group='Pivot Structure')
rsiOverbought = input.int(title='RSI Overbought', defval=70, minval=51, maxval=100, group='Pivot Structure')
rsiOvesold    = input.int(title='RSI Oversold', defval=30, minval=1, maxval=49, group='Pivot Structure')

rsiValue     = ta.rsi(rsiSource, rsiLength)
isOverbought = rsiValue >= rsiOverbought
isOversold   = rsiValue <= rsiOvesold

var laststate = 0
var hh = low
var ll = high

var label labelll = na
var label labelhh = na
var line line_up = na
var line line_down = na

var last_actual_label_hh_price = 0.0
var last_actual_label_ll_price = 0.0

obLabelText() =>
    if last_actual_label_hh_price < high
        'HH'
    else
        'LH'

osLabelText() =>
    if last_actual_label_ll_price < low
        'HL'
    else
        'LL'

createOverBoughtLabel(isIt) =>
    if isIt
        label.new(x=bar_index, y=high, yloc=yloc.abovebar, style=label.style_label_down, color=color.red, size=size.tiny, text=obLabelText())
    else
        label.new(x=bar_index, y=low, yloc=yloc.belowbar, style=label.style_label_up, color=color.green, size=size.tiny, text=osLabelText())

moveOversoldLabel() =>
    label.set_x(labelll, bar_index)
    label.set_y(labelll, low)
    label.set_text(labelll, osLabelText())
    line.set_x1(line_down, bar_index)
    line.set_y1(line_down, low)

moveOverBoughtLabel() =>
    label.set_x(labelhh, bar_index)
    label.set_y(labelhh, high)
    label.set_text(labelhh, obLabelText())
    line.set_x1(line_up, bar_index)
    line.set_y1(line_up, high)

if laststate == 2 and isOverbought
    hh := high
    labelhh := createOverBoughtLabel(true)
    last_actual_label_ll_price := low
    labelll_ts = label.get_x(labelll)
    labelll_price = low
    line_up := line.new(x1=bar_index, y1=high, x2=labelll_ts, y2=labelll_price, width=1)

if laststate == 1 and isOversold
    ll := low
    labelll := createOverBoughtLabel(false)
    last_actual_label_hh_price := high
    labelhh_ts = label.get_x(labelhh)
    labelhh_price = high
    line_down := line.new(x1=bar_index, y1=low, x2=labelhh_ts, y2=labelhh_price, width=1)

if isOverbought
    if high >= hh
        hh := high
        moveOverBoughtLabel()
    laststate := 1

if isOversold
    if low <= ll
        ll := low
        moveOversoldLabel()
    laststate := 2

if laststate == 1 and isOverbought
    if hh <= high
        hh := high
        moveOverBoughtLabel()

if laststate == 2 and isOversold
    if low <= ll
        ll := low
        moveOversoldLabel()

if laststate == 1
    if hh <= high
        hh := high
        moveOverBoughtLabel()

if laststate == 2
    if ll >= low
        ll := low
        moveOversoldLabel()

// ==========================================
// 1-MIN PIVOTS & MARKET STRUCTURE FOR 3-STEP SCALPING
// ==========================================
p_high = ta.pivothigh(high, 2, 2)
p_low  = ta.pivotlow(low, 2, 2)

var float last_confirmed_hh = na
var float last_confirmed_lh = na
var float last_confirmed_hl = na
var float last_confirmed_ll = na
var float last_confirmed_high = na
var float last_confirmed_low = na

if not na(p_high)
    ph_val = p_high
    if na(last_confirmed_high) or ph_val > last_confirmed_high
        last_confirmed_hh := ph_val
    else
        last_confirmed_lh := ph_val
    last_confirmed_high := ph_val

if not na(p_low)
    pl_val = p_low
    if na(last_confirmed_low) or pl_val > last_confirmed_low
        last_confirmed_hl := pl_val
    else
        last_confirmed_ll := pl_val
    last_confirmed_low := pl_val

// Reference prior bar's confirmed structure to avoid self-evaluation bug
ref_hh = not na(last_confirmed_hh[1]) ? last_confirmed_hh[1] : last_confirmed_high[1]
ref_ll = not na(last_confirmed_ll[1]) ? last_confirmed_ll[1] : last_confirmed_low[1]

// Step 1: Liquidity Sweep (Fakeout Capture)
var bool bearish_sweep_active = false
var bool bullish_sweep_active = false

if not na(ref_hh) and high > ref_hh and close < ref_hh
    bearish_sweep_active := true

if not na(ref_ll) and low < ref_ll and close > ref_ll
    bullish_sweep_active := true

// Step 2: 1-Min Body Break (The Trigger)
ref_hl = not na(last_confirmed_hl[1]) ? last_confirmed_hl[1] : last_confirmed_low[1]
ref_lh = not na(last_confirmed_lh[1]) ? last_confirmed_lh[1] : last_confirmed_high[1]

bearish_body_break = not na(ref_hl) and close < ref_hl and close < open
bullish_body_break = not na(ref_lh) and close > ref_lh and close > open

// Step 3: EMA 9 and EMA 15 Dynamic Support
ema_bearish_cross = EMA9_out < EMA15_out
ema_bullish_cross = EMA9_out > EMA15_out

// Dynamic 3-Step Signals
sell_signal = (bearish_sweep_active or (not na(ref_hh) and high > ref_hh and close < ref_hh)) and bearish_body_break and ema_bearish_cross and barstate.isconfirmed
buy_signal  = (bullish_sweep_active or (not na(ref_ll) and low < ref_ll and close > ref_ll)) and bullish_body_break and ema_bullish_cross and barstate.isconfirmed

if sell_signal
    bearish_sweep_active := false

if buy_signal
    bullish_sweep_active := false

// ==========================================
// FIXED FINAL VISUAL SIGNALS & SL/TP
// ==========================================
plotshape(buy_signal, title="BUY Signal (1-Min Scalp)", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY ⚡", textcolor=color.white, size=size.normal)
plotshape(sell_signal, title="SELL Signal (1-Min Scalp)", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL ⚡", textcolor=color.white, size=size.normal)

// Dynamic Risk-Reward SL and TP Tracking (2 pips = 20 minticks offset, 1:2 RR)
pip_offset = 20 * syminfo.mintick

var float active_sl = na
var float active_tp = na

if buy_signal
    sl_val = not na(ref_ll) ? ref_ll - pip_offset : low - pip_offset
    risk = close - sl_val
    tp_val = close + (2.0 * risk)
    active_sl := sl_val
    active_tp := tp_val

if sell_signal
    sl_val = not na(ref_hh) ? ref_hh + pip_offset : high + pip_offset
    risk = sl_val - close
    tp_val = close - (2.0 * risk)
    active_sl := sl_val
    active_tp := tp_val

plot(active_sl, title="Active Stop Loss (SL)", color=color.red, style=plot.style_linebr, linewidth=2)
plot(active_tp, title="Active Take Profit (TP)", color=color.green, style=plot.style_linebr, linewidth=2)

// ==========================================
// FIBONACCI RETRACEMENT
// ==========================================
Fibs = input.string('OFF Fibs', options=['Plot Fibs based on Lookback', 'Plot Fibs based on Price Input', 'OFF Fibs'], title='Fibonacci Plot Type', group='Fib Retracement')
FIBS = Fibs == 'Plot Fibs based on Lookback' ? 1 : Fibs == 'Plot Fibs based on Price Input' ? 2 : Fibs == 'OFF Fibs' ? 3 : na

Foption = input.string(defval='1. Candles', title='Fibonacci Plot Lookback Type', options=['2. Days', '1. Candles'], group='Fib Retracement')
FP = input.int(defval=100, title='Days/Candles to Lookback', group='Fib Retracement')
Reverse = input.bool(defval=false, title='Reverse Fibonacci Levels?', group='Fib Retracement')
ExtraFibs = input.bool(false, 'Show 0.886 and 1.113 Fibs', group='Fib Retracement')

High_input = input.float(0.0, minval=0, title='High - Enter Value', group='Fib Retracement')
Low_input  = input.float(-1.0, minval=-1, title='Low - Enter Value', group='Fib Retracement')

Bull_Color  = input.color(#008000, title='Support Fibs Color', group='Fib Retracement')
Bear_Color  = input.color(#ff0000, title='Resistance Fibs Color', group='Fib Retracement')
CurrentFib  = input.bool(false, 'Show Fib Level of Current Price', group='Fib Retracement')
Current_Color = input.color(color.orange, title='Current Fib Label Color', group='Fib Retracement')
LineStyle   = input.string('Dotted', options=['Dotted', 'Solid'], title='Fib Line Style', group='Fib Retracement')
LineWidth   = input.int(1, minval=1, maxval=3, title='Fib Line Width', group='Fib Retracement')
Ext         = input.bool(false, 'Extend Lines Left', group='Fib Retracement')

FPeriod = timeframe.isintraday and Foption == '2. Days' ? int(1440 / timeframe.multiplier * FP) : timeframe.isdaily and Foption == '2. Days' ? int(FP / timeframe.multiplier) : Foption == '1. Candles' ? FP : 100

Fhigh = FIBS == 1 ? ta.highest(FPeriod) : FIBS == 2 and High_input == 0 ? ta.highest(high, 100) : FIBS == 2 and High_input != 0 ? High_input : na
Flow  = FIBS == 1 ? ta.lowest(FPeriod)  : FIBS == 2 and Low_input == -1  ? ta.lowest(low, 100)  : FIBS == 2 and High_input != -1 ? Low_input  : na
FH    = FIBS == 1 ? ta.highestbars(high, FPeriod) : 1
FL    = FIBS == 1 ? ta.lowestbars(low, FPeriod)  : 2
revfibs = not Reverse ? FL > FH : FL < FH

Fib_x(n) =>
    revfibs ? (Fhigh - Flow) * n + Flow : Fhigh - (Fhigh - Flow) * n

Current = revfibs ? (close - Flow) / (Fhigh - Flow) : (Fhigh - close) / (Fhigh - Flow)

var label Current_Fib_Label = na
label.delete(Current_Fib_Label)

if CurrentFib and barstate.islast
    Current_Fib_Label := label.new(bar_index, close, str.tostring(Current, '##.##'), textcolor=Current_Color, color=color.new(#000000, 100), style=label.style_label_left, yloc=yloc.price)

EXTEND = Ext ? extend.left : extend.none
STYLE  = LineStyle == 'Dotted' ? line.style_dotted : line.style_solid
WIDTH  = LineWidth

BB = FIBS == 1 ? FL < FH ? bar_index[-FL] : bar_index[-FH] : bar_index[50]

Fib_line(x) =>
    var line ln = na
    line.delete(ln)
    if not na(x)
        ln := line.new(BB, x, bar_index, x, color=close > x ? Bull_Color : Bear_Color, extend=EXTEND, style=STYLE, width=WIDTH)
    ln

Fib_label(x, _txt) =>
    var label lbl = na
    label.delete(lbl)
    if not na(x)
        lbl := label.new(bar_index, x, _txt + str.tostring(x, '##.########') + ' )', textcolor=close > x ? Bull_Color : Bear_Color, color=color.new(#000000, 100), style=label.style_label_left, yloc=yloc.price)
    lbl

if FIBS != 3
    Fib0    = Fib_line(Fib_x(0))
    Fib236  = Fib_line(Fib_x(0.236))
    Fib382  = Fib_line(Fib_x(0.382))
    Fib500  = Fib_line(Fib_x(0.500))
    Fib618  = Fib_line(Fib_x(0.618))
    Fib786  = Fib_line(Fib_x(0.786))
    Fib1000 = Fib_line(Fib_x(1.000))

    LFib0    = Fib_label(Fib_x(0), '0 ( ')
    LFib236  = Fib_label(Fib_x(0.236), '0.236 ( ')
    LFib382  = Fib_label(Fib_x(0.382), '0.382 ( ')
    LFib500  = Fib_label(Fib_x(0.500), '0.500 ( ')
    LFib618  = Fib_label(Fib_x(0.618), '0.618 ( ')
    LFib786  = Fib_label(Fib_x(0.786), '0.786 ( ')
    LFib1000 = Fib_label(Fib_x(1.000), '1.000 ( ')

// ==========================================
// ALERTS
// ==========================================
alertcondition(buy_signal, title="1-Min Scalp BUY Signal", message="⚡ 1-Min Scalp BUY Signal Triggered! Check LH Break & EMA Support.")
alertcondition(sell_signal, title="1-Min Scalp SELL Signal", message="⚡ 1-Min Scalp SELL Signal Triggered! Check HL Break & EMA Resistance.")

if buy_signal
    alert("⚡ 1-Min Scalp BUY Signal on " + timeframe.period + " chart. Entry: " + str.tostring(close), alertMode)

if sell_signal
    alert("⚡ 1-Min Scalp SELL Signal on " + timeframe.period + " chart. Entry: " + str.tostring(close), alertMode)
