strategy(title='Thunderbolt 3.0 Strategy', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, pyramiding=1)

// --- SMC: Compatibility Helper ---
fixnan(x) => ta.valuewhen(not na(x), x, 0)


showBB = input.bool(title='Show BB', defval=false, group = 'Bollinger Band')
showVWAP = input.bool(title='Show VWAP', defval=false, group = 'Vwap')
showEMA9 = input.bool(title='showEMA9', defval=false, group = 'EMA 9')
showEMA20 = input.bool(title='showEMA20 ', defval=false, group = 'EMA 20')
showEMA50 = input.bool(title='showEMA50 ', defval=false, group = 'EMA 50')
showEMA100 = input.bool(title='showEMA100', defval=false, group = 'EMA 100')
showEMA200 = input.bool(title='showEMA200', defval=false, group = 'EMA 200')
showSMA9 = input.bool(title='Show SMA-9', defval=false, group = 'SMA 9')
showSMA20 = input.bool(title='Show SMA -20', defval=false, group = 'SMA 20')
showSMA50 = input.bool(title='Show SMA-50', defval=false, group = 'SMA 50')
showSMA100 = input.bool(title='Show SMA-100', defval=false, group = 'SMA 100')
showwMA9 = input.bool(title='Show WMA-9', defval=false, group = 'WMA 9')
showwMA20 = input.bool(title='Show WMA-20', defval=false, group = 'WMA 20')
showwMA50 = input.bool(title='Show WMA-50', defval=false, group = 'WMA 50')
showwMA100 = input.bool(title='Show WMA-100', defval=false, group = 'WMA 100')
showVWMA9 = input.bool(title='Show VWMA9', defval=false, group = 'VWMA9')
showVWMA20 = input.bool(title='Show VWMA20', defval=false, group = 'VWMA20')
showVWMA50 = input.bool(title='Show VWMA50', defval=false, group = 'VWMA50')

showPSAR = input.bool(title='Show PSAR', defval=false, group = 'PSAR')
showPSAR2 = input.bool(title='Show PSAR2', defval=false, group = 'PSAR2')



/////// Alerts ///////
alertMode       =   input.string    (alert.freq_once_per_bar_close              ,   "Alerts Mode" ,                 group  = "Alert Frequency",     options= [alert.freq_once_per_bar, alert.freq_once_per_bar_close])
////////////////////////////////////////////////////////////
//////////////////
//      BB      //
//////////////////
length = input.int(20, minval=1, group = 'Bollinger Band')
src = input.source(close, title='BB_Source', group = 'Bollinger Band')
mult = input.float(2.0, minval=0.001, maxval=50, title='BB_StdDev', group = 'Bollinger Band')
basis = ta.sma(src, length)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
plot(showBB ? basis : na, 'Basis', color=color.new(#872323, 0))
p1 = plot(showBB ? upper : na, 'Upper', color=color.new(color.teal, 0))
p2 = plot(showBB ? lower : na, 'Lower', color=color.new(color.teal, 0))
fill(p1, p2, title='Background', color=color.new(#198787, 95))

