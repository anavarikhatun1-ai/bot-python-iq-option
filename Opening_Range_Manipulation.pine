//@version=5
indicator("Opening Range Manipulation Strategy", shorttitle="OR Manipulation", overlay=true)

// ==========================================
// 1. CORE STRATEGY SETUP & INPUTS
// ==========================================

// Volatility (ATR) and Manipulation Thresholds
atr_length = input.int(96, title="ATR Length (15m Timeframe)", minval=1, group="ATR Volatility Filter")
manip_threshold_pct = input.float(90.0, title="Manipulation Threshold (%)", minval=50.0, maxval=200.0, step=5.0, group="ATR Volatility Filter", tooltip="Lowering this to e.g. 90% slightly increases trade signal frequency while maintaining high conviction.")

// Opening Range / ATR Normalization Filters
min_or_atr_ratio = input.float(0.1, title="Minimum OR Width / ATR Ratio", minval=0.0, step=0.05, group="Opening Range Filter", tooltip="Prevents trading excessively narrow ranges where there is no follow-through.")
max_or_atr_ratio = input.float(2.5, title="Maximum OR Width / ATR Ratio", minval=0.5, step=0.05, group="Opening Range Filter", tooltip="Prevents trading excessively wide ranges with poor risk-reward.")

// Fibonacci Level Entries
long_entry_level = input.string("Either Level (38.2% or 61.8%)", title="Buy Setup Retracement Level", options=["38.2%", "61.8%", "Either Level (38.2% or 61.8%)", "Range Low"], group="Fibonacci Levels & Pullbacks")
short_entry_level = input.string("Either Level (38.2% or 61.8%)", title="Sell Setup Retracement Level", options=["61.8%", "38.2%", "Either Level (38.2% or 61.8%)", "Range High"], group="Fibonacci Levels & Pullbacks")

// Risk Management
sl_mode = input.string("Risk-to-Reward", title="Stop Loss Mode", options=["Risk-to-Reward", "Opening Range Boundaries"], group="Risk Management Settings")
rr_ratio = input.float(1.5, title="Risk-to-Reward Ratio (1 : X)", minval=0.1, step=0.1, group="Risk Management Settings", tooltip="Sugested ratio is 1:1.5 for tighter profit execution.")

// Time and Sessions
session_timezone = input.string("America/New_York", title="Session Timezone", group="Session Settings", tooltip="Timezone used to precisely lock the 9:30 AM Eastern Open.")

// ==========================================
// 2. MULTI-TIMEFRAME DATA FETCHING
// ==========================================

// Fetch 15-minute high, low, open, close, and ATR(96) using the correct, non-repainting request.security call.
// We strictly use lookahead_off and gaps_off as requested by the strategy guidelines.
[sec_high, sec_low, sec_open, sec_close, sec_atr, sec_time] = request.security(
     syminfo.tickerid,
     "15",
     [high, low, open, close, ta.atr(atr_length), time],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
     )

// ==========================================
// 3. PRECISION 9:30 AM EST CANDLE DETECTION
// ==========================================

sec_hour = hour(sec_time, session_timezone)
sec_minute = minute(sec_time, session_timezone)

// Under lookahead_off, the completed 9:30 AM candle (which closes at 9:45) is first returned
// on the 15m chart when the 9:45 AM candle opens. At that exact point, sec_time represents the open time (9:30 AM).
is_930_candle_close = ta.change(sec_time) and (sec_hour == 9) and (sec_minute == 30)

// Persistent state variables for the 9:30 AM EST Opening Range
var float op_high = na
var float op_low = na
var float op_open = na
var float op_close = na
var float op_atr = na
var bool op_is_manip = false
var bool op_is_bullish = false
var bool op_is_bearish = false

// Reset daily trade execution logic to prevent overtrading (max 1 trade per day per symbol)
var bool traded_today = false

if is_930_candle_close
    body_size = math.abs(sec_close - sec_open)
    atr_threshold = sec_atr * (manip_threshold_pct / 100.0)

    // Normalize Opening Range width by ATR (OR/ATR) to avoid trading overly narrow/wide ranges
    or_width = sec_high - sec_low
    or_atr_ratio = or_width / sec_atr
    is_or_size_ok = or_atr_ratio >= min_or_atr_ratio and or_atr_ratio <= max_or_atr_ratio

    // Check if the candle qualifies as an institutional manipulation candle
    if is_or_size_ok and body_size > atr_threshold
        op_high := sec_high
        op_low := sec_low
        op_open := sec_open
        op_close := sec_close
        op_atr := sec_atr
        op_is_manip := true
        op_is_bullish := sec_close > sec_open
        op_is_bearish := sec_close < sec_open
    else
        // Reset state if 9:30 AM candle doesn't qualify
        op_high := na
        op_low := na
        op_open := na
        op_close := na
        op_atr := na
        op_is_manip := false
        op_is_bullish := false
        op_is_bearish := false

    traded_today := false

// Fibonacci level calculations within the qualified 9:30 AM candle
range_size = op_high - op_low
fib_382 = op_low + (range_size * 0.382)
fib_618 = op_low + (range_size * 0.618)

// ==========================================
// 4. RETRACEMENT TOUCH DETECTION (1-MINUTE CHART)
// ==========================================

bool long_touch_382 = (low <= fib_382)
bool long_touch_618 = (low <= fib_618)
bool long_touch_low = (low <= op_low)

bool short_touch_382 = (high >= fib_382)
bool short_touch_618 = (high >= fib_618)
bool short_touch_high = (high >= op_high)

bool long_triggered = false
float target_long_entry = na

if long_entry_level == "38.2%" and long_touch_382
    target_long_entry := fib_382
    long_triggered := true
else if long_entry_level == "61.8%" and long_touch_618
    target_long_entry := fib_618
    long_triggered := true
else if long_entry_level == "Range Low" and long_touch_low
    target_long_entry := op_low
    long_triggered := true
else if long_entry_level == "Either Level (38.2% or 61.8%)"
    if long_touch_618
        target_long_entry := fib_618
        long_triggered := true
    else if long_touch_382
        target_long_entry := fib_382
        long_triggered := true

bool short_triggered = false
float target_short_entry = na

if short_entry_level == "38.2%" and short_touch_382
    target_short_entry := fib_382
    short_triggered := true
else if short_entry_level == "61.8%" and short_touch_618
    target_short_entry := fib_618
    short_triggered := true
else if short_entry_level == "Range High" and short_touch_high
    target_short_entry := op_high
    short_triggered := true
else if short_entry_level == "Either Level (38.2% or 61.8%)"
    if short_touch_382
        target_short_entry := fib_382
        short_triggered := true
    else if short_touch_618
        target_short_entry := fib_618
        short_triggered := true

// ==========================================
// 5. SIGNAL GENERATION LOGIC
// ==========================================

// To ensure complete stability and prevent repainting, we strictly require barstate.isconfirmed.
// This guarantees that signals and alerts only fire on fully closed/confirmed 1-minute candles.
long_signal = barstate.isconfirmed and op_is_bearish and (not traded_today) and long_triggered
short_signal = barstate.isconfirmed and op_is_bullish and (not traded_today) and short_triggered

// State tracking for plotting execution levels
var float active_entry_price = na
var float active_tp_price = na
var float active_sl_price = na
var int active_direction = 0 // 1 for Long, -1 for Short, 0 for None

if long_signal
    traded_today := true
    active_direction := 1
    active_entry_price := target_long_entry
    // Target is the opposite Fibonacci level
    active_tp_price := short_entry_level == "61.8%" ? fib_618 : (short_entry_level == "38.2%" ? fib_382 : op_high)
    if sl_mode == "Risk-to-Reward"
        reward_dist = math.abs(active_tp_price - active_entry_price)
        risk_dist = reward_dist / rr_ratio
        active_sl_price := active_entry_price - risk_dist
    else
        active_sl_price := op_low

    // Place visual labels
    label.new(bar_index, low, text="Buy", color=color.green, textcolor=color.white, style=label.style_label_up)

if short_signal
    traded_today := true
    active_direction := -1
    active_entry_price := target_short_entry
    // Target is the opposite Fibonacci level
    active_tp_price := long_entry_level == "38.2%" ? fib_382 : (long_entry_level == "61.8%" ? fib_618 : op_low)
    if sl_mode == "Risk-to-Reward"
        reward_dist = math.abs(active_tp_price - active_entry_price)
        risk_dist = reward_dist / rr_ratio
        active_sl_price := active_entry_price + risk_dist
    else
        active_sl_price := op_high

    // Place visual labels
    label.new(bar_index, high, text="Sell", color=color.red, textcolor=color.white, style=label.style_label_down)

// Check for exits
if active_direction == 1
    if high >= active_tp_price
        active_direction := 0
    else if low <= active_sl_price
        active_direction := 0

if active_direction == -1
    if low <= active_tp_price
        active_direction := 0
    else if high >= active_sl_price
        active_direction := 0

// Reset trade states when day changes (using timezone)
if ta.change(time("D", session_timezone))
    active_direction := 0
    active_entry_price := na
    active_tp_price := na
    active_sl_price := na
    op_is_bullish := false  // Reset to prevent pre-9:45 AM signals using yesterday's levels
    op_is_bearish := false  // Reset to prevent pre-9:45 AM signals using yesterday's levels
    op_high := na
    op_low := na

// ==========================================
// 6. CHART PLOTS, LABELS & ALERTS
// ==========================================

// Draw Opening Range Levels
plot(op_high, title="OR High", color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)
plot(op_low, title="OR Low", color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)

// Draw Fibonacci Levels
plot(fib_382, title="OR Fib 38.2%", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(fib_618, title="OR Fib 61.8%", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// Plot Active Trade Levels
plot(active_direction != 0 ? active_entry_price : na, title="Active Entry Price", color=color.blue, style=plot.style_linebr, linewidth=1)
plot(active_direction != 0 ? active_tp_price : na, title="Active Take Profit", color=color.green, style=plot.style_linebr, linewidth=1)
plot(active_direction != 0 ? active_sl_price : na, title="Active Stop Loss", color=color.red, style=plot.style_linebr, linewidth=1)

// Alert Integrations
alertcondition(long_signal, title="Institutional Buy Alert", message="Opening Range Manipulation: Institutional BUY Entry Triggered!")
alertcondition(short_signal, title="Institutional Sell Alert", message="Opening Range Manipulation: Institutional SELL Entry Triggered!")

// ==========================================
// 7. SESSION STATUS DASHBOARD TABLE
// ==========================================
var table info_table = table.new(position.top_right, 2, 5, border_width = 1, border_color = color.gray)

if barstate.islast
    // Header Row
    table.cell(info_table, 0, 0, "Metric", bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "Value", bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)

    // Range Boundaries Row
    table.cell(info_table, 0, 1, "Opening Range", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 1, na(op_high) ? "Pending" : str.tostring(op_low, "#.##") + " - " + str.tostring(op_high, "#.##"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)

    // Body vs ATR metric
    table.cell(info_table, 0, 2, "9:30 AM Body/ATR", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 2, na(op_open) ? "Pending" : str.tostring(math.abs(op_close - op_open), "#.##") + " / " + str.tostring(op_atr, "#.##"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)

    // Manipulation Status Row
    table.cell(info_table, 0, 3, "Manipulation Status", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    string status_txt = "Pending"
    color status_col = color.gray
    if not na(op_high)
        if op_is_bullish
            status_txt := "Bullish Manipulation"
            status_col := color.red
        else if op_is_bearish
            status_txt := "Bearish Manipulation"
            status_col := color.green
        else
            status_txt := "No Manipulation"
            status_col := color.blue
    table.cell(info_table, 1, 3, status_txt, bgcolor=color.new(status_col, 50), text_color=color.white, text_size=size.small)

    // Setup Setup Row
    table.cell(info_table, 0, 4, "Current Bias", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    string bias_txt = "Pending"
    color bias_col = color.gray
    if not na(op_high)
        if op_is_bullish
            bias_txt := "Sell Setup at " + (short_entry_level == "Either Level (38.2% or 61.8%)" ? "Fib Levels" : short_entry_level)
            bias_col := color.orange
        else if op_is_bearish
            bias_txt := "Buy Setup at " + (long_entry_level == "Either Level (38.2% or 61.8%)" ? "Fib Levels" : long_entry_level)
            bias_col := color.teal
        else
            bias_txt := "No Setup"
            bias_col := color.gray
    table.cell(info_table, 1, 4, bias_txt, bgcolor=color.new(bias_col, 50), text_color=color.white, text_size=size.small)
