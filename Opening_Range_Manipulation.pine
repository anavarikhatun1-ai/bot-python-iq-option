//@version=5
indicator("Opening Range Manipulation Strategy", shorttitle="OR Manipulation", overlay=true)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================

// Timeframe Settings
var string TIMEFRAME_15M = "15"

// ATR Settings
atr_length = input.int(96, title="ATR Length (15m Timeframe)", minval=1, group="ATR Manipulation Settings")
manip_threshold_pct = input.float(100.0, title="Manipulation Threshold (%)", minval=0.0, maxval=500.0, step=5.0, group="ATR Manipulation Settings", tooltip="Body must exceed this % of ATR to be considered manipulation")

// Fibonacci Level Selection
short_entry_sel = input.string("Either Level (38.2% or 61.8%)", title="Short Entry Target Level", options=["61.8%", "38.2%", "Either Level (38.2% or 61.8%)", "Range High"], group="Fibonacci Levels & Execution")
short_tp_sel = input.string("38.2%", title="Short Take Profit Target Level", options=["38.2%", "61.8%", "Range Low"], group="Fibonacci Levels & Execution")

long_entry_sel = input.string("Either Level (38.2% or 61.8%)", title="Long Entry Target Level", options=["38.2%", "61.8%", "Either Level (38.2% or 61.8%)", "Range Low"], group="Fibonacci Levels & Execution")
long_tp_sel = input.string("61.8%", title="Long Take Profit Target Level", options=["61.8%", "38.2%", "Range High"], group="Fibonacci Levels & Execution")

// Risk Management
sl_mode = input.string("Risk-to-Reward", title="Stop Loss Mode", options=["Risk-to-Reward", "Opening Range High/Low (S/D)", "Manual Ticks"], group="Risk Management")
rr_ratio = input.float(1.5, title="Risk-to-Reward Ratio (1 : X)", minval=0.1, step=0.1, group="Risk Management", tooltip="Used if Risk-to-Reward mode is selected")
manual_sl_ticks = input.int(100, title="Manual SL Ticks/Pips Offset", minval=1, group="Risk Management", tooltip="Used if Manual Ticks mode is selected")

// Session Settings
session_timezone = input.string("America/New_York", title="Session Timezone", group="Session Settings")
only_intraday = input.bool(false, title="Restrict Execution to Intraday Session Window", group="Session Settings", tooltip="If enabled, scanning and trades will only occur within the Execution Session Window below.")
trading_session_input = input.string("0930-1600:23456", title="Execution Session Window", group="Session Settings", tooltip="Used if Intraday Restriction is enabled.")

// ==========================================
// 2. MULTI-TIMEFRAME DATA FETCHING
// ==========================================

// Fetch 15-minute high, low, open, close, time, and ATR(96) to prevent repainting.
// We use lookahead = barmerge.lookahead_off and gaps = barmerge.gaps_on.
[sec_high, sec_low, sec_open, sec_close, sec_atr, sec_time] = request.security(
     syminfo.tickerid,
     TIMEFRAME_15M,
     [high, low, open, close, ta.atr(atr_length), time],
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off
     )

// ==========================================
// 3. CONTINUOUS SCANNING & RANGE COMPUTATIONS
// ==========================================

// Check if we are currently inside the active session/scanning window
in_execution_session = only_intraday ? (not na(time(timeframe.period, trading_session_input, session_timezone))) : true

// A non-na sec_time with gaps_on indicates that a new 15-minute candle has just opened.
// At this exact point on the 1-minute chart, the values returned are the fully closed/finalized
// high, low, open, close and ATR of the previous 15-minute candle, ensuring 100% non-repainting.
is_new_15m_candle = (not na(sec_time)) and in_execution_session

// Persistent state variables for the latest Manipulation Range (Impulse)
var float op_high = na
var float op_low = na
var float op_open = na
var float op_close = na
var float op_atr = na
var bool op_is_manip = false
var bool op_is_bullish = false
var bool op_is_bearish = false

// State tracking for trade execution (allowing multiple trades per day/range)
var float active_entry_price = na
var float active_tp_price = na
var float active_sl_price = na
var int active_direction = 0 // 1 for Long, -1 for Short, 0 for None
var int last_trade_bar = 0   // Track bar index of last entry to prevent duplicate entries on the same bar

// Scan every 15-minute candle close
if is_new_15m_candle
    body_size = math.abs(sec_close - sec_open)
    atr_threshold = sec_atr * (manip_threshold_pct / 100.0)

    // Check if the 15-minute candle is a Manipulation Candle (Impulse)
    if body_size > atr_threshold
        // Capture new range and reset Fibonacci levels
        op_high := sec_high
        op_low := sec_low
        op_open := sec_open
        op_close := sec_close
        op_atr := sec_atr
        op_is_manip := true
        op_is_bullish := sec_close > sec_open
        op_is_bearish := sec_close < sec_open

        // Reset current active trade state to look for fresh entries on the new range immediately
        active_direction := 0
        active_entry_price := na
        active_tp_price := na
        active_sl_price := na

// Bias state based on the latest captured manipulation candle
bool has_bullish_bias = op_is_manip and op_is_bullish
bool has_bearish_bias = op_is_manip and op_is_bearish

// Fibonacci calculations for the latest range
range_size = op_high - op_low
fib_382 = op_low + (range_size * 0.382)
fib_618 = op_low + (range_size * 0.618)

// ==========================================
// 4. RETRACEMENT TOUCH DETECTION
// ==========================================

// Touch/cross checks for entry targets
bool long_touch_382 = (high >= fib_382 and low <= fib_382)
bool long_touch_618 = (high >= fib_618 and low <= fib_618)
bool long_touch_low = (high >= op_low and low <= op_low)

bool short_touch_382 = (high >= fib_382 and low <= fib_382)
bool short_touch_618 = (high >= fib_618 and low <= fib_618)
bool short_touch_high = (high >= op_high and low <= op_high)

// Determine target entry price and trigger flags dynamically
float target_long_entry = na
bool long_triggered = false

if long_entry_sel == "38.2%" and long_touch_382
    target_long_entry := fib_382
    long_triggered := true
else if long_entry_sel == "61.8%" and long_touch_618
    target_long_entry := fib_618
    long_triggered := true
else if long_entry_sel == "Range Low" and long_touch_low
    target_long_entry := op_low
    long_triggered := true
else if long_entry_sel == "Either Level (38.2% or 61.8%)"
    if long_touch_382
        target_long_entry := fib_382
        long_triggered := true
    else if long_touch_618
        target_long_entry := fib_618
        long_triggered := true

float target_short_entry = na
bool short_triggered = false

if short_entry_sel == "61.8%" and short_touch_618
    target_short_entry := fib_618
    short_triggered := true
else if short_entry_sel == "38.2%" and short_touch_382
    target_short_entry := fib_382
    short_triggered := true
else if short_entry_sel == "Range High" and short_touch_high
    target_short_entry := op_high
    short_triggered := true
else if short_entry_sel == "Either Level (38.2% or 61.8%)"
    if short_touch_618
        target_short_entry := fib_618
        short_triggered := true
    else if short_touch_382
        target_short_entry := fib_382
        short_triggered := true

// ==========================================
// 5. SIGNAL GENERATION LOGIC
// ==========================================

// Long Entry Condition (Bearish Impulse):
long_entry_condition = has_bearish_bias and in_execution_session and (active_direction == 0) and (bar_index > last_trade_bar) and long_triggered

// Short Entry Condition (Bullish Impulse):
short_entry_condition = has_bullish_bias and in_execution_session and (active_direction == 0) and (bar_index > last_trade_bar) and short_triggered

// Dynamic TP calculation based on selections
f_get_tp(is_long, entry_p) =>
    float calculated_tp = na
    if is_long
        calculated_tp := long_tp_sel == "61.8%" ? fib_618 : (long_tp_sel == "38.2%" ? fib_382 : op_high)
    else
        calculated_tp := short_tp_sel == "38.2%" ? fib_382 : (short_tp_sel == "61.8%" ? fib_618 : op_low)
    calculated_tp

// Dynamic SL calculation based on selections
f_calculate_sl(is_long, entry_p, tp_p) =>
    float calculated_sl = na
    if sl_mode == "Risk-to-Reward"
        reward_dist = math.abs(tp_p - entry_p)
        risk_dist = reward_dist / rr_ratio
        calculated_sl := is_long ? (entry_p - risk_dist) : (entry_p + risk_dist)
    else if sl_mode == "Opening Range High/Low (S/D)"
        calculated_sl := is_long ? op_low : op_high
    else // Manual Ticks
        calculated_sl := is_long ? (entry_p - (manual_sl_ticks * syminfo.mintick)) : (entry_p + (manual_sl_ticks * syminfo.mintick))
    calculated_sl

// Execute Long Trade State
if long_entry_condition
    active_direction := 1
    last_trade_bar := bar_index
    active_entry_price := target_long_entry
    active_tp_price := f_get_tp(true, target_long_entry)
    active_sl_price := f_calculate_sl(true, target_long_entry, active_tp_price)

// Execute Short Trade State
if short_entry_condition
    active_direction := -1
    last_trade_bar := bar_index
    active_entry_price := target_short_entry
    active_tp_price := f_get_tp(false, target_short_entry)
    active_sl_price := f_calculate_sl(false, target_short_entry, active_tp_price)

// Manage Active Trade Exits & Resets (TP, SL or session close if intraday restriction is on)
if active_direction == 1 // Active Long
    if high >= active_tp_price // Take Profit Hit
        active_direction := 0
    else if low <= active_sl_price // Stop Loss Hit
        active_direction := 0
    else if only_intraday and (not in_execution_session) // End of Trading Window
        active_direction := 0

if active_direction == -1 // Active Short
    if low <= active_tp_price // Take Profit Hit
        active_direction := 0
    else if high >= active_sl_price // Stop Loss Hit
        active_direction := 0
    else if only_intraday and (not in_execution_session) // End of Trading Window
        active_direction := 0

// ==========================================
// 6. CHART PLOTS, LABELS & ALERTS
// ==========================================

// Draw Impulse Range Levels
plot(in_execution_session ? op_high : na, title="Impulse High", color=color.new(color.red, 30), linewidth=2, style=plot.style_linebr)
plot(in_execution_session ? op_low : na, title="Impulse Low", color=color.new(color.green, 30), linewidth=2, style=plot.style_linebr)

// Draw Fibonacci Levels within the session
plot(in_execution_session ? fib_382 : na, title="Impulse Fib 38.2%", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(in_execution_session ? fib_618 : na, title="Impulse Fib 61.8%", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// Plot Active Trade Levels
plot(active_direction != 0 ? active_entry_price : na, title="Active Entry Price", color=color.blue, style=plot.style_linebr, linewidth=1)
plot(active_direction != 0 ? active_tp_price : na, title="Active Take Profit", color=color.green, style=plot.style_linebr, linewidth=1)
plot(active_direction != 0 ? active_sl_price : na, title="Active Stop Loss", color=color.red, style=plot.style_linebr, linewidth=1)

// Visual Entry Labels (Shape arrows / text)
plotshape(long_entry_condition, title="Buy Signal Label", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.normal)
plotshape(short_entry_condition, title="Sell Signal Label", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.normal)

// Alert Integrations
alertcondition(long_entry_condition, title="Institutional Buy Alert", message="Opening Range Manipulation: Institutional BUY Entry Triggered!")
alertcondition(short_entry_condition, title="Institutional Sell Alert", message="Opening Range Manipulation: Institutional SELL Entry Triggered!")

// ==========================================
// 7. SESSION STATUS DASHBOARD TABLE
// ==========================================
var table info_table = table.new(position.top_right, 2, 5, border_width = 1, border_color = color.gray)

if barstate.islast
    // Header Row
    table.cell(info_table, 0, 0, "Metric", bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "Value", bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)

    // Range Boundaries Row
    table.cell(info_table, 0, 1, "Latest Impulse Range", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 1, na(op_high) ? "Scanning..." : str.tostring(op_low, "#.##") + " - " + str.tostring(op_high, "#.##"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)

    // Body vs ATR metric
    table.cell(info_table, 0, 2, "Latest Body/ATR", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 2, na(op_open) ? "Scanning..." : str.tostring(math.abs(op_close - op_open), "#.##") + " / " + str.tostring(op_atr, "#.##"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)

    // Manipulation Status Row
    table.cell(info_table, 0, 3, "Impulse Status", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    string status_txt = "Scanning..."
    color status_col = color.gray
    if not na(op_high)
        if op_is_bullish
            status_txt := "Bullish Impulse"
            status_col := color.red
        else if op_is_bearish
            status_txt := "Bearish Impulse"
            status_col := color.green
        else
            status_txt := "No Impulse"
            status_col := color.blue
    table.cell(info_table, 1, 3, status_txt, bgcolor=color.new(status_col, 50), text_color=color.white, text_size=size.small)

    // Bias Setup Row
    table.cell(info_table, 0, 4, "Current Bias", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    string bias_txt = "Scanning..."
    color bias_col = color.gray
    if not na(op_high)
        if has_bullish_bias
            bias_txt := "Short Setup at " + (short_entry_sel == "Either Level (38.2% or 61.8%)" ? "Fib Levels" : short_entry_sel)
            bias_col := color.orange
        else if has_bearish_bias
            bias_txt := "Long Setup at " + (long_entry_sel == "Either Level (38.2% or 61.8%)" ? "Fib Levels" : long_entry_sel)
            bias_col := color.teal
        else
            bias_txt := "No Setup"
            bias_col := color.gray
    table.cell(info_table, 1, 4, bias_txt, bgcolor=color.new(bias_col, 50), text_color=color.white, text_size=size.small)
