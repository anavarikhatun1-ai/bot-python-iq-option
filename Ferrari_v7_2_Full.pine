//@version=5
// ════════════════════════════════════════════════════════════════════════════
//  SCALPPRO ELITE v7.2 — FULL FERRARI EDITION
//  Complete: SMC + Volume Profile + Order Blocks + Gaps + ORB + Regime
//  Zero-repaint  |  5-min NSE/BSE  |  Production Ready
// ════════════════════════════════════════════════════════════════════════════

indicator("Ferrari v7.2 Full", overlay=true, max_bars_back=500, max_lines_count=100, max_labels_count=200, max_boxes_count=100)

// ── 1. USER INPUTS ──────────────────────────────────────────────────────────
pivotLen     = input.int(3, "Pivot Lookback", minval=2, maxval=6)
htfTF        = input.timeframe("15", "HTF Timeframe")
atrLen       = input.int(8, "ATR Length", minval=5, maxval=20)
adxThresh    = input.int(18, "ADX Min Threshold", minval=10, maxval=35)
ciRangeThresh = input.float(55.0, "CI Range Threshold", minval=40, maxval=70)

capital      = input.float(1000000, "Capital (Rs)", step=100000)
riskPerTrade = input.float(0.75, "Risk % per trade", minval=0.25, maxval=2.0, step=0.25)
slMode       = input.string("WIDE", "SL Mode", options=["CONSERVATIVE","STANDARD","WIDE"])
minRR        = input.float(1.8, "Min R:R", step=0.1)
cooldownBars = input.int(3, "Cooldown Bars", minval=1, maxval=10)
maxLots      = input.int(5, "Max Lots (Broker Limit)", minval=1, maxval=50)

wA           = input.int(4, "Weight A (Structure)", minval=1, maxval=5)
wB           = input.int(3, "Weight B (Volume)", minval=0, maxval=5)
wC           = input.int(3, "Weight C (Order Flow)", minval=1, maxval=5)

wA_Trend     = input.float(1.5, "A Multiplier Trend", step=0.1)
wB_Range     = input.float(1.5, "B Multiplier Range", step=0.1)
wC_Range     = input.float(1.8, "C Multiplier Range", step=0.1)

minScore     = input.float(55.0, "Min Score", step=5.0)
sessionMode  = input.string("India Power", "Session", options=["India Power","India Full","India Opening"])
expiryBlock  = input.bool(true, "Block Expiry Post 14:30")
showLabels   = input.bool(true, "Show Labels")
showBoxes    = input.bool(true, "Show OB Boxes")
showDashboard = input.bool(true, "Show Dashboard")

// ── 2. TIME & SESSION ──────────────────────────────────────────────────────
_istH = hour(time, "Asia/Kolkata")
_istM = minute(time, "Asia/Kolkata")
_istTotalMin = _istH * 60 + _istM

_newDay = ta.change(time("D")) != 0
var int dayBarNum = 0
if _newDay
    dayBarNum := 0
dayBarNum += 1

_isWeekday = dayofweek(time, "Asia/Kolkata") >= 2 and dayofweek(time, "Asia/Kolkata") <= 6
_isGapBar = dayBarNum <= 2

_isThursday = dayofweek(time, "Asia/Kolkata") == 5
_dom = dayofmonth(time, "Asia/Kolkata")
_isExpiryDay = _isThursday and _dom >= 22
_expiryBlockActive = _isExpiryDay and _istTotalMin >= 870 and expiryBlock

_inOpen  = _istTotalMin >= 560 and _istTotalMin < 600
_inPower = _istTotalMin >= 840 and _istTotalMin < 920
_inFull  = _istTotalMin >= 560 and _istTotalMin < 920

sessionGate = not _isWeekday ? false : _isGapBar ? false : _expiryBlockActive ? false :
              sessionMode == "India Power" ? (_inOpen or _inPower) :
              sessionMode == "India Opening" ? _inOpen : _inFull

bgcolor(_isWeekday and _inOpen ? color.new(color.teal, 90) : na)
bgcolor(_isWeekday and _inPower ? color.new(color.orange, 90) : na)

// ── 3. ATR, ADX, CI, REGIME ──────────────────────────────────────────────
atr = ta.atr(atrLen)
_atrH = ta.highest(atr, 50)
_atrL = ta.lowest(atr, 50)
normAtrPct = (_atrH - _atrL) > 0 ? (atr - _atrL) / (_atrH - _atrL) : 0.0

_atrRma = ta.rma(ta.tr(true), atrLen)
_dmP = ta.rma(math.max(high-high[1], 0) > math.max(low[1]-low, 0) ? math.max(high-high[1], 0) : 0, atrLen)
_dmM = ta.rma(math.max(low[1]-low, 0) > math.max(high-high[1], 0) ? math.max(low[1]-low, 0) : 0, atrLen)
_diP = 100.0 * _dmP / math.max(_atrRma, syminfo.mintick)
_diM = 100.0 * _dmM / math.max(_atrRma, syminfo.mintick)
_dx = 100.0 * math.abs(_diP - _diM) / math.max(_diP + _diM, syminfo.mintick)
adx = ta.rma(_dx, atrLen)
adxMA = ta.sma(adx, 50)
adxDynamic = math.max(adxThresh, adxMA)

_ciNum = ta.sum(ta.tr(true), atrLen)
_ciDen = ta.highest(high, atrLen) - ta.lowest(low, atrLen)
ci = 100.0 * math.log10(math.max(_ciNum, syminfo.mintick) / math.max(_ciDen, syminfo.mintick)) / math.log10(atrLen)

regimeTrend = adx >= adxDynamic and ci < ciRangeThresh
regimeRange = ci >= ciRangeThresh and adx < adxDynamic
regimeTrans = not regimeTrend and not regimeRange

var float regimeScore = 0.0
if barstate.isconfirmed
    if regimeTrend and regimeScore < 0.8
        regimeScore := regimeScore + 0.1
    if regimeRange and regimeScore > -0.8
        regimeScore := regimeScore - 0.1
    if regimeTrans
        regimeScore := regimeScore * 0.95
    regimeScore := math.min(math.max(regimeScore, -1.0), 1.0)

regimeTrendSmooth = regimeScore > 0.3
regimeRangeSmooth = regimeScore < -0.3

// ── 4. VWAP ────────────────────────────────────────────────────────────────
vwap = ta.vwap(hlc3)
vwapBull = close > vwap
vwapBear = close < vwap
_vwapProxLong = close > vwap and close < vwap + 0.5 * atr
_vwapProxShort = close < vwap and close > vwap - 0.5 * atr
plot(vwap, color=color.new(color.yellow, 25), linewidth=1)

// ── 5. PRIOR OHLC ──────────────────────────────────────────────────────────
[_dClose, _dHigh, _dLow] = request.security(syminfo.tickerid, "D", [close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)

// ── 6. OPENING RANGE (ORB) ────────────────────────────────────────────────
var float orHigh = na
var float orLow = na
var bool orLocked = false
var int orLockBar = na
if _newDay
    orHigh := na
    orLow := na
    orLocked := false
    orLockBar := na
_inOR = dayBarNum >= 2 and dayBarNum <= 9
if _inOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow := na(orLow) ? low : math.min(orLow, low)
if dayBarNum == 10 and not orLocked and not na(orHigh)
    orLocked := true
    orLockBar := bar_index
_orbTimeOk = orLocked and not na(orLockBar) and (bar_index - orLockBar) <= 24
orbBull = _orbTimeOk and not na(orHigh) and close > orHigh and barstate.isconfirmed
orbBear = _orbTimeOk and not na(orLow) and close < orLow and barstate.isconfirmed

// ── 7. SMC STRUCTURE ──────────────────────────────────────────────────────
smcHP = ta.pivothigh(math.max(open, close), pivotLen, pivotLen)
smcLP = ta.pivotlow(math.min(open, close), pivotLen, pivotLen)

var float smcLH = na
var float smcPH = na
var int smcLHB = na
var float smcLL = na
var float smcPL = na
var int smcLLB = na
var float smcBullAnc = na
var float smcBearAnc = na
var bool bosBullFired = false
var bool bosBearFired = false
var int smcState = 0

int _smcGap = pivotLen * 2
if not na(smcHP)
    if na(smcLHB) or (bar_index - smcLHB) >= _smcGap
        smcPH := smcLH
        smcLHB := bar_index
        smcLH := smcHP
        bosBullFired := false
if not na(smcLP)
    if na(smcLLB) or (bar_index - smcLLB) >= _smcGap
        smcPL := smcLL
        smcLLB := bar_index
        smcLL := smcLP
        bosBearFired := false
smcHH = not na(smcLH) and not na(smcPH) and smcLH > smcPH
smcHL = not na(smcLL) and not na(smcPL) and smcLL > smcPL
smcLHc = not na(smcLH) and not na(smcPH) and smcLH < smcPH
smcLLc = not na(smcLL) and not na(smcPL) and smcLL < smcPL
if barstate.isconfirmed
    if smcState <= 0 and smcHH and smcHL
        smcState := 1
    if smcState >= 0 and smcLHc and smcLLc
        smcState := -1
smcBull = smcState == 1
smcBear = smcState == -1

// ── 8. HTF RSI ──────────────────────────────────────────────────────────────
htfRsi = request.security(syminfo.tickerid, htfTF, ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
htfBull = htfRsi > 50
htfBear = htfRsi < 50

// ── 9. VOLUME ENGINE ───────────────────────────────────────────────────────
_mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
cmf = ta.sum(_mfm * volume, atrLen) / math.max(ta.sum(volume, atrLen), 1)
cmfStd = ta.stdev(cmf, 30)
cmfBullThresh = 0.0 + 1.0 * cmfStd
cmfBearThresh = 0.0 - 1.0 * cmfStd

avgVol20 = ta.sma(volume, 20)
rvol = volume / math.max(avgVol20, 1)
rvolPercentile = ta.percentile_nearest_rank(rvol, 50, 80)
rvolOk = rvol >= rvolPercentile

_pocPrice = ta.valuewhen(volume == ta.highest(volume, 20), close, 0)
pocBull = not na(_pocPrice) and close > _pocPrice
pocBear = not na(_pocPrice) and close < _pocPrice

liqSS = ta.lowest(low, pivotLen)
liqBS = ta.highest(high, pivotLen)
sweepBull = low[1] < liqSS[2] and close > liqSS[2] and rvolOk and barstate.isconfirmed
sweepBear = high[1] > liqBS[2] and close < liqBS[2] and rvolOk and barstate.isconfirmed

// ── 10. VOLUME-CONFIRMED BoS ──────────────────────────────────────────────
_bosVolConf = rvolOk
bool bosBull = false
bool bosBear = false
if barstate.isconfirmed
    if smcState == 1 and not na(smcLH) and close > smcLH and not bosBullFired and _bosVolConf
        bosBull := true
        bosBullFired := true
        smcBullAnc := smcLL
    if smcState == -1 and not na(smcLL) and close < smcLL and not bosBearFired and _bosVolConf
        bosBear := true
        bosBearFired := true
        smcBearAnc := smcLH

// ── 11. GAP DETECTION ──────────────────────────────────────────────────────
var float gapHigh = na
var float gapLow = na
var int gapDir = 0
var bool gapFilled = true
var int gapEntBar = na

if _newDay and barstate.isconfirmed
    gapHigh := na
    gapLow := na
    gapFilled := true
    gapEntBar := na
    gapDir := 0
    _todayOpen = open
    if not na(_dHigh) and not na(_dLow)
        if _todayOpen > _dHigh
            gapHigh := _todayOpen
            gapLow := _dHigh
            gapDir := 1
            gapFilled := false
        else if _todayOpen < _dLow
            gapHigh := _dLow
            gapLow := _todayOpen
            gapDir := -1
            gapFilled := false
if not gapFilled and barstate.isconfirmed
    if gapDir == 1 and low <= gapLow
        gapFilled := true
        gapEntBar := bar_index
    if gapDir == -1 and high >= gapHigh
        gapFilled := true
        gapEntBar := bar_index
_gapDecay = gapFilled and not na(gapEntBar) ? math.max(0.0, 1.0 - (bar_index - gapEntBar) / 3.0) : 1.0
_gapScoreLong = (gapDir == 1 and not na(gapHigh) and close > gapHigh) ? 0.20 * _gapDecay : 0.0
_gapScoreShort = (gapDir == -1 and not na(gapLow) and close < gapLow) ? 0.20 * _gapDecay : 0.0

// ── 12. ORDER BLOCKS (ENHANCED) ──────────────────────────────────────────
_volSpike = volume > 2.0 * avgVol20
_impUp = (close - close[1]) > 0.8 * atr and close > open and _volSpike
_impDn = (close[1] - close) > 0.8 * atr and close < open and _volSpike
_liquiditySweepBeforeBull = low[1] < ta.lowest(low, 5)[2]
_liquiditySweepBeforeBear = high[1] > ta.highest(high, 5)[2]
_obBull = _impUp and close[1] < open[1] and _liquiditySweepBeforeBull and htfBull
_obBear = _impDn and close[1] > open[1] and _liquiditySweepBeforeBear and htfBear

var float[] obH = array.new_float(0)
var float[] obL = array.new_float(0)
var int[] obBar = array.new_int(0)
var int[] obDir = array.new_int(0)
var bool[] obMit = array.new_bool(0)
var box[] obBx = array.new_box(0)

if barstate.isconfirmed and (_newDay or dayBarNum >= 74)
    if array.size(obH) > 0
        for _ci = array.size(obH)-1 to 0 by -1
            if showBoxes and _ci < array.size(obBx)
                box.delete(array.get(obBx, _ci))
    array.clear(obH)
    array.clear(obL)
    array.clear(obBar)
    array.clear(obDir)
    array.clear(obMit)
    if showBoxes
        array.clear(obBx)

if barstate.isconfirmed and not _isGapBar and sessionGate
    if _obBull
        array.push(obH, high[1])
        array.push(obL, low[1])
        array.push(obBar, bar_index-1)
        array.push(obDir, 1)
        array.push(obMit, false)
        if showBoxes
            array.push(obBx, box.new(bar_index-1, high[1], bar_index+15, low[1], border_color=color.new(color.teal,40), bgcolor=color.new(color.teal,88), border_width=1))
    if _obBear
        array.push(obH, high[1])
        array.push(obL, low[1])
        array.push(obBar, bar_index-1)
        array.push(obDir, -1)
        array.push(obMit, false)
        if showBoxes
            array.push(obBx, box.new(bar_index-1, high[1], bar_index+15, low[1], border_color=color.new(color.red,40), bgcolor=color.new(color.red,88), border_width=1))

float _obScore_long = 0.0
float _obScore_short = 0.0
bool obMitBull = false
bool obMitBear = false
if barstate.isconfirmed
    _sz = array.size(obH)
    if _sz > 0
        for _i = 0 to _sz-1
            if not array.get(obMit, _i)
                float _zh = array.get(obH, _i)
                float _zl = array.get(obL, _i)
                int _zd = array.get(obDir, _i)
                bool _inZ = low <= _zh and high >= _zl
                bool _nearZ = low <= _zh + atr and high >= _zl - atr
                if _zd == 1
                    if _nearZ and not _inZ
                        _obScore_long := math.max(_obScore_long, 0.35)
                    if _inZ
                        _obScore_long := math.max(_obScore_long, 0.60)
                        if close > open
                            array.set(obMit, _i, true)
                            obMitBull := true
                            _boost = close > _zh + 0.5 * atr ? 0.10 : 0.0
                            _obScore_long := math.min(1.0 + _boost, 1.10)
                            if showBoxes and _i < array.size(obBx)
                                box.set_border_color(array.get(obBx, _i), color.new(color.teal, 10))
                    if not array.get(obMit, _i) and showBoxes and _i < array.size(obBx)
                        box.set_right(array.get(obBx, _i), bar_index+15)
                if _zd == -1
                    if _nearZ and not _inZ
                        _obScore_short := math.max(_obScore_short, 0.35)
                    if _inZ
                        _obScore_short := math.max(_obScore_short, 0.60)
                        if close < open
                            array.set(obMit, _i, true)
                            obMitBear := true
                            _boost = close < _zl - 0.5 * atr ? 0.10 : 0.0
                            _obScore_short := math.min(1.0 + _boost, 1.10)
                            if showBoxes and _i < array.size(obBx)
                                box.set_border_color(array.get(obBx, _i), color.new(color.red, 10))
                    if not array.get(obMit, _i) and showBoxes and _i < array.size(obBx)
                        box.set_right(array.get(obBx, _i), bar_index+15)

// OB Trim
if barstate.isconfirmed
    var int[] _rm = array.new_int(0)
    array.clear(_rm)
    _sz2 = array.size(obH)
    if _sz2 > 0
        int _actCnt = 0
        for _i = _sz2-1 to 0 by -1
            bool _isOld = (bar_index - array.get(obBar, _i)) > 15
            bool _isDone = array.get(obMit, _i)
            if _isOld or _isDone
                array.push(_rm, _i)
            else
                _actCnt += 1
                if _actCnt > 3
                    array.push(_rm, _i)
    _rsz = array.size(_rm)
    if _rsz > 0
        array.sort(_rm, order.descending)
        for _r = 0 to _rsz-1
            int _idx = array.get(_rm, _r)
            if _idx < array.size(obH)
                if showBoxes and _idx < array.size(obBx)
                    box.delete(array.get(obBx, _idx))
                    array.remove(obBx, _idx)
                array.remove(obH, _idx)
                array.remove(obL, _idx)
                array.remove(obBar, _idx)
                array.remove(obDir, _idx)
                array.remove(obMit, _idx)

pillarC_long = math.min(_obScore_long + _gapScoreLong, 1.10)
pillarC_short = math.min(_obScore_short + _gapScoreShort, 1.10)

// ── 13. PILLAR A (Structure) ──────────────────────────────────────────────
pillarA_long = (smcBull ? 0.20 : 0.0) + (htfBull ? 0.20 : 0.0) + (adx >= adxDynamic ? 0.20 : 0.0) + (_vwapProxLong ? 0.20 : vwapBull ? 0.10 : 0.0) + (orbBull ? 0.05 : 0.0) + (pocBull ? 0.15 : 0.0)
pillarA_short = (smcBear ? 0.20 : 0.0) + (htfBear ? 0.20 : 0.0) + (adx >= adxDynamic ? 0.20 : 0.0) + (_vwapProxShort ? 0.20 : vwapBear ? 0.10 : 0.0) + (orbBear ? 0.05 : 0.0) + (pocBear ? 0.15 : 0.0)

// ── 14. PILLAR B (Volume) ──────────────────────────────────────────────────
pillarB_long = (cmf > cmfBullThresh ? 0.40 : cmf > 0.0 ? 0.20 : 0.0) + (rvolOk ? 0.30 : 0.0) + (sweepBull ? 0.30 : 0.0)
pillarB_short = (cmf < cmfBearThresh ? 0.40 : cmf < 0.0 ? 0.20 : 0.0) + (rvolOk ? 0.30 : 0.0) + (sweepBear ? 0.30 : 0.0)

// ── 15. SCORING ────────────────────────────────────────────────────────────
_wA_eff = wA * (regimeTrendSmooth ? wA_Trend : 1.0)
_wB_eff = wB * (regimeRangeSmooth ? wB_Range : 1.0)
_wC_eff = wC * (regimeRangeSmooth ? wC_Range : 1.0)
float _maxPoss = float(_wA_eff + _wB_eff + _wC_eff)

scoreLong = (_wA_eff * pillarA_long + _wB_eff * pillarB_long + _wC_eff * pillarC_long) / _maxPoss * 100.0
scoreShort = (_wA_eff * pillarA_short + _wB_eff * pillarB_short + _wC_eff * pillarC_short) / _maxPoss * 100.0

// ── 16. RISK & POSITION SIZING ────────────────────────────────────────────
_slBase = slMode == "CONSERVATIVE" ? 1.0 : slMode == "WIDE" ? 2.0 : 1.5
_slRegime = regimeTrendSmooth ? 1.5 : regimeRangeSmooth ? 2.0 : 1.75
_slMult = _slRegime * (normAtrPct > 0.75 ? 1.30 : 1.0) * (_isExpiryDay ? 1.25 : 1.0)
_tpMult = _slMult * 2.0

longSL = close - _slMult * atr
longTP = close + _tpMult * atr
shortSL = close + _slMult * atr
shortTP = close - _tpMult * atr

longRR_ok = (longTP - close) / math.max(close - longSL, syminfo.mintick) >= minRR
shortRR_ok = (close - shortTP) / math.max(shortSL - close, syminfo.mintick) >= minRR

_pointValue = syminfo.pointvalue
_riskAmount = capital * (riskPerTrade / 100)
_qty_raw = _riskAmount / (_slMult * atr * _pointValue)
_qty_floor = int(math.floor(_qty_raw))
qty = int(math.min(math.max(_qty_floor, 0), maxLots))
plot(qty, title="Qty", display=display.none)

// ── 17. SIGNALS ────────────────────────────────────────────────────────────
var int lastLongBar = na
var int lastShortBar = na
_longCoolOk = na(lastLongBar) or (bar_index - lastLongBar) > cooldownBars
_shortCoolOk = na(lastShortBar) or (bar_index - lastShortBar) > cooldownBars

longSignal = scoreLong >= minScore and sessionGate and longRR_ok and _longCoolOk and barstate.isconfirmed
shortSignal = scoreShort >= minScore and sessionGate and shortRR_ok and _shortCoolOk and barstate.isconfirmed

if longSignal
    lastLongBar := bar_index
if shortSignal
    lastShortBar := bar_index

// ── 18. PLOTS ──────────────────────────────────────────────────────────────
plotshape(longSignal, title="LONG", style=shape.arrowup, location=location.belowbar, color=color.new(color.green, 0), size=size.normal)
plotshape(shortSignal, title="SHORT", style=shape.arrowdown, location=location.abovebar, color=color.new(color.red, 0), size=size.normal)
plotshape(sweepBull, title="Sweep↑", style=shape.triangleup, location=location.belowbar, color=color.new(color.blue, 20), size=size.small)
plotshape(sweepBear, title="Sweep↓", style=shape.triangledown, location=location.abovebar, color=color.new(color.purple, 20), size=size.small)
bgcolor(regimeTrendSmooth ? color.new(color.blue, 97) : na)
bgcolor(regimeRangeSmooth ? color.new(color.gray, 95) : na)

// ── 19. LABELS ─────────────────────────────────────────────────────────────
if showLabels and longSignal
    _reg = regimeTrendSmooth ? "TREND" : regimeRangeSmooth ? "RANGE" : "TRANS"
    _win = _inOpen ? "OPEN" : _inPower ? "POWER" : "SESSION"
    label.new(bar_index, low, "▲ LONG [" + _reg + "|" + _win + "]\nScore: " + str.tostring(math.round(scoreLong, 1)) + "\nA:" + str.tostring(math.round(pillarA_long * 100, 0)) + " B:" + str.tostring(math.round(pillarB_long * 100, 0)) + " C:" + str.tostring(math.round(pillarC_long * 100, 0)) + "\nSL:" + str.tostring(math.round(longSL, 1)) + " TP:" + str.tostring(math.round(longTP, 1)) + " Qty:" + str.tostring(qty), style=label.style_label_up, color=color.new(color.green, 15), textcolor=color.white, size=size.small, yloc=yloc.belowbar)

if showLabels and shortSignal
    _reg = regimeTrendSmooth ? "TREND" : regimeRangeSmooth ? "RANGE" : "TRANS"
    _win = _inOpen ? "OPEN" : _inPower ? "POWER" : "SESSION"
    label.new(bar_index, high, "▼ SHORT [" + _reg + "|" + _win + "]\nScore: " + str.tostring(math.round(scoreShort, 1)) + "\nA:" + str.tostring(math.round(pillarA_short * 100, 0)) + " B:" + str.tostring(math.round(pillarB_short * 100, 0)) + " C:" + str.tostring(math.round(pillarC_short * 100, 0)) + "\nSL:" + str.tostring(math.round(shortSL, 1)) + " TP:" + str.tostring(math.round(shortTP, 1)) + " Qty:" + str.tostring(qty), style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=size.small, yloc=yloc.abovebar)

// ── 20. DASHBOARD ──────────────────────────────────────────────────────────
if showDashboard
    var table dash = table.new(position.top_right, 2, 22, border_color=color.new(color.gray, 50), border_width=1)
    if barstate.islast
        table.cell(dash, 0, 0, "Ferrari v7.2", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
        table.cell(dash, 1, 0, "5-min NSE", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
        _rStr = regimeTrendSmooth ? "TREND" : regimeRangeSmooth ? "RANGE" : "TRANS"
        _rClr = regimeTrendSmooth ? color.lime : regimeRangeSmooth ? color.gray : color.yellow

        table.cell(dash, 0, 1, "Regime", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 1, _rStr, text_color=_rClr, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 2, "ADX", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 2, str.tostring(math.round(adx, 1)), text_color=adx>=adxDynamic?color.lime:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 3, "CI", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 3, str.tostring(math.round(ci, 1)), text_color=ci>ciRangeThresh?color.red:ci<38?color.lime:color.yellow, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 4, "SMC", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 4, smcState==1?"BULL":smcState==-1?"BEAR":"NEUTRAL", text_color=smcState==1?color.lime:smcState==-1?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 5, "HTF RSI", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 5, str.tostring(math.round(htfRsi, 1)), text_color=htfBull?color.lime:htfBear?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 6, "VWAP", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 6, vwapBull?"Above":"Below", text_color=vwapBull?color.lime:color.red, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 7, "POC", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 7, not na(_pocPrice)?str.tostring(math.round(_pocPrice, 1)):"—", text_color=pocBull?color.lime:pocBear?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 8, "OR", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 8, orLocked?"H:"+str.tostring(math.round(orHigh, 1)):"Building", text_color=color.aqua, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 9, "ORB", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 9, orbBull?"BULL":orbBear?"BEAR":"—", text_color=orbBull?color.lime:orbBear?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 10, "Gap", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 10, gapDir==1?"UP":gapDir==-1?"DOWN":"NONE", text_color=gapDir!=0?color.orange:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 11, "CMF", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 11, str.tostring(math.round(cmf, 3)), text_color=cmf>cmfBullThresh?color.lime:cmf<cmfBearThresh?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 12, "RVOL", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 12, str.tostring(math.round(rvol, 2))+"x", text_color=rvolOk?color.yellow:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 13, "ATR%", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 13, str.tostring(math.round(normAtrPct*100, 0))+"%", text_color=normAtrPct>0.75?color.orange:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 14, "Session", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 14, sessionGate?"ACTIVE":"BLOCKED", text_color=sessionGate?color.lime:color.red, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 15, "Pillar A", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 15, "L:"+str.tostring(math.round(pillarA_long*100,0))+" S:"+str.tostring(math.round(pillarA_short*100,0)), text_color=color.aqua, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 16, "Pillar B", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 16, "L:"+str.tostring(math.round(pillarB_long*100,0))+" S:"+str.tostring(math.round(pillarB_short*100,0)), text_color=color.aqua, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 17, "Pillar C", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 17, "L:"+str.tostring(math.round(pillarC_long*100,0))+" S:"+str.tostring(math.round(pillarC_short*100,0)), text_color=color.aqua, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 18, "Score", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 18, str.tostring(math.round(scoreLong,1))+"/"+str.tostring(math.round(scoreShort,1)), text_color=(scoreLong>=minScore or scoreShort>=minScore)?color.lime:color.yellow, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 19, "OB Status", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 19, obMitBull?"Bull MIT":obMitBear?"Bear MIT":"Active:"+str.tostring(array.size(obH)), text_color=obMitBull?color.lime:obMitBear?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 20, "LONG", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 20, longSignal?"● ACTIVE":"—", text_color=longSignal?color.lime:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

        table.cell(dash, 0, 21, "SHORT", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black, 78))
        table.cell(dash, 1, 21, shortSignal?"● ACTIVE":"—", text_color=shortSignal?color.red:color.gray, text_size=size.tiny, bgcolor=color.new(color.black, 78))

// ── 21. ALERTS (EXECUTION READY) ──────────────────────────────────────────
_regStr = regimeTrendSmooth ? "TREND" : regimeRangeSmooth ? "RANGE" : "TRANS"
_expMsg = _isExpiryDay ? " [EXPIRY]" : ""

alertcondition(longSignal,
    title="LONG Signal",
    message="LONG|{{ticker}}|qty:" + str.tostring(qty) + "|entry:" + str.tostring(close) + "|SL:" + str.tostring(longSL) + "|TP:" + str.tostring(longTP) + "|score:" + str.tostring(math.round(scoreLong, 1)) + "|regime:" + _regStr + "|session:" + sessionMode + _expMsg)

alertcondition(shortSignal,
    title="SHORT Signal",
    message="SHORT|{{ticker}}|qty:" + str.tostring(qty) + "|entry:" + str.tostring(close) + "|SL:" + str.tostring(shortSL) + "|TP:" + str.tostring(shortTP) + "|score:" + str.tostring(math.round(scoreShort, 1)) + "|regime:" + _regStr + "|session:" + sessionMode + _expMsg)
